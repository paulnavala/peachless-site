---
// A closing "where next" band. Every page's <main> ends in one (or another
// [data-next-step] element), so no page is a dead end.
interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  tone?: 'paper' | 'blush' | 'inverse';
  id?: string;
  /** The page ends here. A band further up the page is only a band. */
  nextStep?: boolean;
  class?: string;
  /** Passed through, so the builder can find the section. */
  [attr: string]: unknown;
}
const { eyebrow, heading, body, tone = 'blush', id = 'next-step-title', nextStep = true, class: className, ...rest } = Astro.props;
---
<section
  class:list={['cta-band sheet', className]}
  data-surface={tone}
  data-next-step={nextStep ? '' : undefined}
  aria-labelledby={id}
  {...rest}
>
  <div class="container cta-band__inner">
    <div class="cta-band__text">
      {eyebrow && <p class="eyebrow" data-field="eyebrow">{eyebrow}</p>}
      <h2 id={id} class="cta-band__title t-h2" data-field="heading">{heading}</h2>
      {body && <p class="cta-band__body" data-field="body">{body}</p>}
    </div>
    <div class="cluster cta-band__actions">
      <slot />
    </div>
  </div>
</section>

<style>
  .cta-band {
    container-type: inline-size;
    padding-block: var(--space-xl-3xl);
  }

  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m) var(--space-xl);
  }

  .cta-band__text {
    display: grid;
    gap: var(--space-xs);
    max-width: 40rem;
  }

  .cta-band__body {
    color: var(--color-text-secondary);
  }

  .cta-band__actions {
    --cluster-gap: var(--space-s) var(--space-l);
  }

  /* On a phone the links are a list, rather than a row that leaves one behind. */
  @container (width < 30rem) {
    .cta-band__actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
