---
// The "peachless." wordmark of the brand book (Minion Semibold), outlined so it
// keeps its letterforms whatever the site's display face is.
// Source: Crimson Pro 600 (@fontsource-variable/crimson-pro 5.3.0, latin),
// shaped with HarfBuzz (kerning on), tracked -0.01em, 1024 units per em.
// The viewBox is the line box of `line-height: 1` text (baseline 861 units
// down), so the mark sits exactly where that text did; the "p" descends below
// it, hence overflow: visible. Any other site name (set in the CMS) falls back
// to live display text.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  /** The site name; also the accessible name. */
  name: string;
}

const { name, class: className, ...rest } = Astro.props;
const OUTLINED = 'peachless.';
const WIDTH = 4269;
