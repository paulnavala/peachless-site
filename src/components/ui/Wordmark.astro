---
{
  name === OUTLINED ? (
    <span class:list={['wordmark', className]} {...rest}>
      <svg viewBox={`0 -861 ${WIDTH} 1024`} width={`${WIDTH / 1024}em`} height="1em" aria-hidden="true" focusable="false">
        <path d={PATH} />
      </svg>
      <span class="sr-only">{name}</span>
    </span>
  ) : (
    <span class:list={['wordmark wordmark--text', className]} {...rest}>{name}</span>
  )
}

<style>
  /* One line box tall, so the mark centres exactly like the text it replaces. */
  .wordmark {
    display: inline-flex;
    align-items: center;
    block-size: 1lh;
  }

  .wordmark svg {
    display: block;
    overflow: visible;
    fill: currentColor;
  }

  .wordmark--text {
    font-family: var(--font-display);
    font-weight: var(--weight-display-sm);
    letter-spacing: var(--tracking-heading);
  }
</style>
