---
// A statement that lights up word by word as it scrolls through the screen
// (data-scroll="lit" in src/styles/motion.css). The words stay ordinary inline
// text, so the element reads, wraps and kerns like any heading or paragraph;
// without scroll timelines, or under reduced motion, it is simply lit.
// Unlit words use --color-text-dim (3:1 at best), so use it for large text only.
import { litHtml, litWords } from '../../lib/formatters';

interface Props {
  text: string;
  tag?: 'h2' | 'p';
  id?: string;
  class?: string;
  /** Passed through, so a parent's scoped styles reach the element. */
  [attr: string]: unknown;
}
const { text, tag = 'h2', id, class: className, ...rest } = Astro.props;
const Tag = tag;
---
<Tag {...rest} id={id} class:list={['lit', className]} data-reveal data-scroll="lit" style={{ '--lit-n': litWords(text).length }} set:html={litHtml(text)} />
