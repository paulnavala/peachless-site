---
import ArrowLink from './ArrowLink.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  id?: string;
  action?: { href: string; label: string };
}
const { eyebrow, title, lede, id, action } = Astro.props;
---
<header class="section-header">
  <div class="section-header__text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id} class="section-header__title t-h2">{title}</h2>
    {lede && <p class="lede">{lede}</p>}
  </div>
  {action && <ArrowLink class="section-header__action" href={action.href}>{action.label}</ArrowLink>}
</header>

<style>
  /* The link sits under the text on phones and at the right from tablets up,
     whatever the length of the lede (a wrapping row placed it either way). */
  .section-header {
    display: grid;
    align-items: end;
    justify-items: start;
    gap: var(--space-s) var(--space-l);
    margin-block-end: var(--space-l-2xl);
  }

  @media (min-width: 48em) {
    .section-header {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .section-header__text {
    display: grid;
    gap: var(--space-xs);
    max-width: 44rem;
  }

  .section-header__title {
    margin: 0;
  }
</style>
