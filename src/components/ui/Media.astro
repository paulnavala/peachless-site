---
// One image, the right way: AVIF + WebP <picture> for raster artwork, plain
// <img> for SVG (brand-book pages and vector marks must stay vector).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Layout width hint, e.g. "(min-width: 64em) 50vw, 100vw". */
  sizes: string;
  widths?: number[];
  /** The page's LCP image: eager + high fetch priority. */
  priority?: boolean;
  /** Load straight away without raising its priority (in the first screen, not the LCP). */
  eager?: boolean;
  fit?: 'cover' | 'contain';
  class?: string;
}

const { image, alt, sizes, widths, priority = false, eager = false, fit = 'cover', class: className } = Astro.props;
const loading = priority || eager ? 'eager' : 'lazy';
const isSvg = image.format === 'svg' || /\.svg(\?|$)/.test(image.src);
const candidates = (widths ?? [480, 800, 1200, 1600, 2400]).filter((w) => w <= image.width);
const sources = candidates.length ? candidates : [image.width];
const classes = ['media', fit === 'contain' ? 'media--contain' : 'media--cover', className];
---
{
  isSvg ? (
    <img
      class:list={classes}
      src={image.src}
      width={image.width}
      height={image.height}
      alt={alt}
      loading={loading}
      decoding="async"
    />
  ) : (
    <Picture
      class:list={classes}
      src={image}
      alt={alt}
      widths={sources}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={loading}
      decoding="async"
      fetchpriority={priority ? 'high' : undefined}
    />
  )
}
