---
// The next story, in its own colour: a band that hands the reader on. Its
// title and cover carry the next project's view-transition names, so they
// morph into that project's hero.
import type { Project } from '../../lib/content';
import { disciplineList } from '../../lib/content-schema';
import { projectTheme } from '../../lib/project-theme';
import ArrowLink from '../ui/ArrowLink.astro';
import Media from '../ui/Media.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, summary, disciplines, cover, accent } = project.data;
---
<section class="next-project sheet" data-next-step aria-labelledby="next-project-title" style={projectTheme(accent)}>
  <div class="container next-project__inner">
    <div class="next-project__text">
      <p class="eyebrow">Next story</p>
      <h2 id="next-project-title" class="next-project__title work-title" style={{ '--vt-title': `work-title-${project.id}` }}>
        <a class="next-project__link" href={`/projects/${project.id}/`} data-testid="next-project">{title}</a>
      </h2>
      <p class="next-project__meta">{disciplineList(disciplines)}</p>
      <p class="next-project__summary">{summary}</p>
      <ArrowLink class="next-project__all" href="/projects/">All work</ArrowLink>
    </div>
    <a
      class="next-project__media work-media"
      href={`/projects/${project.id}/`}
      tabindex="-1"
      aria-hidden="true"
      data-panel={cover.panel}
      data-cursor="Next"
      style={{ '--vt': `work-${project.id}` }}
    >
      <Media image={cover.image} alt="" sizes="(min-width: 64em) 44rem, 100vw" fit={cover.fit} />
    </a>
  </div>
</section>

<style>
  .next-project {
    padding-block: var(--space-xl-3xl);
    background: var(--project-tint, var(--blush));
  }

  .next-project__inner {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  .next-project__text {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }

  .next-project__title {
    font-size: var(--text-hero);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .next-project__link {
    color: var(--color-heading);
    text-decoration: none;
  }

  .next-project__link:is(:hover, :focus-visible) {
    color: var(--color-accent-text);
  }

  .next-project__meta {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .next-project__summary {
    color: var(--color-text-secondary);
    max-width: 46ch;
  }

  .next-project__all {
    margin-block-start: var(--space-s);
  }

  .next-project__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: clip;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    --panel-pad: 16%;
  }

  .next-project__media :global(picture) {
    height: 100%;
  }

  @media (min-width: 64em) {
    .next-project__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .next-project__inner:is(:hover, :focus-within) .next-project__media :global(.media) {
      scale: var(--hover-scale);
    }
  }
</style>
