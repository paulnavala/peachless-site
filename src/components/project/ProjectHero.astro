---
// A project's opening: a band in the project's own colour (it runs up under
// the transparent header), the title, a line of credits, the chapters of the
// story when there are enough of them, and the cover overlapping the band.
import type { Project } from '../../lib/content';
import type { Chapter } from '../../lib/chapters';
import { DISCIPLINE_LABELS, TOOL_LABELS, disciplineList } from '../../lib/content-schema';
import ArrowLink from '../ui/ArrowLink.astro';
import Media from '../ui/Media.astro';

interface Props {
  project: Project;
  /** The story's chapters, for the "In this story" list (empty: no list). */
  chapters?: Chapter[];
}
const { project, chapters = [] } = Astro.props;
const { title, summary, disciplines, year, client, role, tools, cover } = project.data;
const credits = [
  { term: 'Year', value: year },
  { term: 'Context', value: client },
  { term: 'My role', value: role, wide: true },
  { term: disciplines.length > 1 ? 'Disciplines' : 'Discipline', value: disciplineList(disciplines) },
  { term: 'Tools', value: tools.map((t) => TOOL_LABELS[t]).join(', ') },
].filter((c) => c.value);
const pad = (n: number) => String(n).padStart(2, '0');
---
<header class="project-hero">
  <div class="container project-hero__top">
    <div class="project-hero__nav">
      <ArrowLink href="/projects/" direction="back">All work</ArrowLink>
      <ul class="cluster project-hero__tags" role="list" aria-label="Disciplines">
        {disciplines.map((d) => <li><a class="tag project-hero__tag" href={`/projects/${d}/`}>{DISCIPLINE_LABELS[d]}</a></li>)}
      </ul>
    </div>
    <h1
      class="project-hero__title work-title"
      data-size={title.length <= 12 ? 'short' : 'long'}
      style={{ '--vt-title': `work-title-${project.id}` }}
    >
      {title}
    </h1>
    <div class="project-hero__intro">
      <p class="lede project-hero__lede">{summary}</p>
      {
        credits.length > 0 && (
          <dl class="project-credits">
            {credits.map((c) => (
              <div class:list={{ 'is-wide': c.wide }}>
                <dt>{c.term}</dt>
                <dd>{c.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
    {
      chapters.length > 0 && (
        <nav class="project-toc" aria-labelledby="project-toc-title">
          <p id="project-toc-title" class="eyebrow">In this story</p>
          <ol role="list">
            {chapters.map((c, i) => (
              <>
                <li>
                  <a href={`#${c.id}`}>
                    <span class="project-toc__num" aria-hidden="true">{pad(i + 1)}</span>
                    <span class="project-toc__title">{c.title}</span>
                  </a>
                </li>{' '}
              </>
            ))}
          </ol>
        </nav>
      )
    }
  </div>
  <div class="container container--wide">
    <div class="project-hero__media work-media" data-panel={cover.panel} style={{ '--vt': `work-${project.id}` }}>
      <Media image={cover.image} alt={cover.alt} sizes="(min-width: 90rem) 90rem, 100vw" fit={cover.fit} priority />
    </div>
  </div>
</header>

<style>
  .project-hero {
    --overlap: clamp(3rem, 12vw, 11rem);
    /* The band starts under the transparent header and stops --overlap above
       the cover's lower edge, so the cover sits half on it. */
    margin-block-start: calc(-1 * var(--header-h));
    padding-block: calc(var(--header-h) + var(--space-m)) var(--space-l-2xl);
    background: linear-gradient(var(--project-tint, var(--blush)) 0 0) no-repeat 0 0 / 100% calc(100% - var(--overlap) - var(--space-l-2xl));
  }

  .project-hero__top {
    display: grid;
    gap: var(--space-m);
    margin-block-end: var(--space-l-2xl);
  }

  .project-hero__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .project-hero__tags {
    margin: 0;
    --cluster-gap: var(--space-3xs);
  }

  .project-hero__tag {
    background: var(--paper);
    color: var(--ink-strong);
    text-decoration: none;
  }

  .project-hero__tag:is(:hover, :focus-visible) {
    background: var(--espresso);
    color: var(--linen);
  }

  .project-hero__title {
    max-width: 16ch;
    margin-block: var(--space-s) var(--space-2xs);
    font-size: var(--text-hero);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .project-hero__title[data-size='short'] {
    font-size: var(--text-display);
  }

  .project-hero__intro {
    display: grid;
    gap: var(--space-m);
  }

  .project-hero__lede {
    max-width: 44ch;
    color: var(--color-text);
  }

  .project-credits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s) var(--space-m);
    margin: 0;
    padding-block: var(--space-s);
    border-block: 1px solid rgb(var(--espresso-rgb) / 0.14);
  }

  .project-credits dt {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .project-credits dd {
    margin: var(--space-3xs) 0 0;
    font-weight: var(--weight-medium);
  }

  .project-credits .is-wide {
    grid-column: 1 / -1;
  }

  /* "In this story": the chapters as a quiet contents line, numbered in the
     project's ink; a chapter title underlines like any quiet link. */
  .project-toc {
    display: grid;
    gap: var(--space-3xs);
    min-width: 0;
  }

  /* A run of chapters set as text, so its lines balance (never a lone chapter
     on the last line); the spaces between them are the gaps. On phones, a list. */
  .project-toc ol {
    margin: 0;
    text-wrap: balance;
    word-spacing: var(--space-m);
  }

  .project-toc li {
    display: inline;
  }

  .project-toc a {
    display: inline-block;
    padding-block: 0.7em;
    color: var(--color-text);
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
    text-decoration: none;
    word-spacing: normal;
    white-space: nowrap;
  }

  @media (width < 36em) {
    .project-toc li {
      display: block;
    }

    .project-toc a {
      padding-block: 0.45em;
      white-space: normal;
    }
  }

  .project-toc__num {
    margin-inline-end: 0.45em;
    color: var(--project-ink, var(--color-accent-text));
    font-variant-numeric: tabular-nums;
  }

  .project-toc__title {
    padding-block-end: 0.15em;
    background: linear-gradient(var(--project-ink, var(--color-accent-text)) 0 0) 100% 100% / 0 1.5px no-repeat;
  }

  .project-toc a:is(:hover, :focus-visible) .project-toc__title {
    background-position: 0 100%;
    background-size: 100% 1.5px;
  }

  .project-hero__media {
    aspect-ratio: 16 / 9;
    overflow: clip;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    --panel-pad: 9% 22%;
  }

  .project-hero__media :global(picture) {
    height: 100%;
  }

  /* A cropped cover is a screenshot: keep its top (the page's own header) in
     view, like a browser window would. */
  .project-hero__media :global(.media--cover) {
    object-position: top;
  }

  @media (min-width: 48em) {
    .project-credits {
      display: flex;
      flex-wrap: wrap;
    }

    .project-credits > div {
      flex: 1 1 8rem;
    }

    .project-credits .is-wide {
      flex: 2.5 1 14rem;
    }
  }

  @media (min-width: 64em) {
    .project-hero__intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: var(--space-xl);
    }

  }

  @media (prefers-reduced-motion: no-preference) {
    .project-hero__tag {
      transition:
        background-color var(--duration-fast) var(--ease-standard),
        color var(--duration-fast) var(--ease-standard);
    }

    .project-toc__title {
      transition: background-size var(--duration-base) var(--ease-out);
    }
  }
</style>
