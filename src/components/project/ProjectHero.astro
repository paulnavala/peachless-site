---
import type { Project } from '../../lib/content';
import { DISCIPLINE_LABELS, TOOL_LABELS } from '../../lib/content-schema';
import ArrowLink from '../ui/ArrowLink.astro';
import Media from '../ui/Media.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, summary, disciplines, year, client, role, tools, cover } = project.data;
const meta = [
  { term: disciplines.length > 1 ? 'Disciplines' : 'Discipline', value: disciplines.map((d) => DISCIPLINE_LABELS[d]).join(', ') },
  { term: 'Year', value: year },
  { term: 'Context', value: client },
  { term: 'My role', value: role },
  { term: 'Tools', value: tools.map((t) => TOOL_LABELS[t]).join(', ') },
].filter((m) => m.value);
---
<header class="project-hero">
  <div class="container project-hero__top">
    <div class="project-hero__nav">
      <ArrowLink href="/projects/" direction="back">All work</ArrowLink>
      <ul class="cluster project-hero__tags" role="list" aria-label="Disciplines">
        {disciplines.map((d) => <li><a class="tag project-hero__tag" href={`/projects/${d}/`}>{DISCIPLINE_LABELS[d]}</a></li>)}
      </ul>
    </div>
    <div class="project-hero__intro">
      <h1 class="project-hero__title">{title}</h1>
      <div class="project-hero__aside">
        <p class="lede">{summary}</p>
        <dl class="project-hero__meta">
          {
            meta.map((m) => (
              <div>
                <dt>{m.term}</dt>
                <dd>{m.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
  <div class="container container--wide">
    <div class="project-hero__media work-media" data-panel={cover.panel} style={`--vt: work-${project.id}`}>
      <Media image={cover.image} alt={cover.alt} sizes="(min-width: 90rem) 90rem, 100vw" fit={cover.fit} priority />
    </div>
  </div>
</header>

<style>
  .project-hero {
    padding-block: var(--space-m) var(--space-l-2xl);
  }

  .project-hero__top {
    display: grid;
    gap: var(--space-l);
    margin-block-end: var(--space-l-2xl);
  }

  .project-hero__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .project-hero__tags {
    margin: 0;
    --cluster-gap: var(--space-3xs);
  }

  .project-hero__tag {
    text-decoration: none;
  }

  .project-hero__tag:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .project-hero__intro {
    display: grid;
    gap: var(--space-m);
  }

  .project-hero__title {
    font-size: var(--text-h1);
    max-width: 14ch;
  }

  .project-hero__aside {
    display: grid;
    gap: var(--space-m);
    align-content: end;
  }

  .project-hero__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s) var(--space-m);
    margin: 0;
    padding-block-start: var(--space-s);
    border-top: 1px solid var(--color-border);
  }

  .project-hero__meta dt {
    font-size: var(--text-micro);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project-hero__meta dd {
    margin: var(--space-3xs) 0 0;
    font-weight: var(--weight-medium);
  }

  .project-hero__media {
    aspect-ratio: 16 / 9;
    overflow: clip;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    --panel-pad: 9% 22%;
  }

  .project-hero__media :global(picture) {
    height: 100%;
  }

  @media (min-width: 64em) {
    .project-hero__intro {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: var(--space-xl);
    }
  }
</style>
