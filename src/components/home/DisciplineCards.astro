---
import type { ImageMetadata } from 'astro';
import Media from '../ui/Media.astro';

export interface DisciplineCard {
  title: string;
  description: string;
  href: string;
  count: string;
  image?: { image: ImageMetadata; panel: string; fit: 'cover' | 'contain' };
}

interface Props {
  cards: DisciplineCard[];
}
const { cards } = Astro.props;
---
<ol class="disciplines" role="list">
  {
    cards.map((card, i) => (
      <li class="discipline card" data-reveal style={`--reveal-index: ${i}`}>
        {card.image && (
          <div class="card__media discipline__media" data-panel={card.image.panel}>
            <Media image={card.image.image} alt="" sizes="(min-width: 64em) 24rem, (min-width: 36em) 45vw, 100vw" fit={card.image.fit} />
          </div>
        )}
        <div class="discipline__body">
          <span class="numeral discipline__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="discipline__title">
            <a class="card__link" href={card.href}>
              {card.title}
            </a>
          </h3>
          <p class="discipline__text">{card.description}</p>
          <p class="discipline__count">{card.count}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .disciplines {
    display: grid;
    gap: var(--space-l);
    margin: 0;
  }

  @media (min-width: 48em) {
    .disciplines {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .discipline {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  .discipline__media {
    --ratio: 4 / 3;
    --panel-pad: 18%;
  }

  .discipline__body {
    display: grid;
    gap: var(--space-2xs);
  }

  .discipline__num {
    font-size: var(--step-3);
  }

  .discipline__title {
    font-size: var(--step-3);
  }

  .discipline__text {
    color: var(--color-text-secondary);
  }

  .discipline__count {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--color-accent-text);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .discipline__media :global(.media) {
      transition: scale 600ms var(--ease-out);
    }

    .discipline:hover .discipline__media :global(.media) {
      scale: var(--hover-scale);
    }
  }
</style>
