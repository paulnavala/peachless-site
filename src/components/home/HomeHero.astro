---
import Tagline from './Tagline.astro';
import PeachMark from '../ui/PeachMark.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  eyebrow?: string;
  line1: string;
  line2: string;
  lede?: string;
  primary: { label: string; link: string };
  secondary?: { label: string; link: string };
}
const { eyebrow, line1, line2, lede, primary, secondary } = Astro.props;
---
<section class="home-hero" aria-label="Introduction">
  <div class="container home-hero__inner">
    <div class="home-hero__text">
      {eyebrow && <p class="eyebrow eyebrow--rule">{eyebrow}</p>}
      <Tagline line1={line1} line2={line2} />
      {lede && <p class="lede home-hero__lede">{lede}</p>}
      <div class="cluster home-hero__actions">
        <a class="btn btn--lg" href={primary.link}>
          {primary.label}
          <Icon name="arrow-right" />
        </a>
        {secondary && <a class="btn btn--secondary btn--lg" href={secondary.link}>{secondary.label}</a>}
      </div>
    </div>
    <div class="home-hero__art" aria-hidden="true">
      <span class="home-hero__sun"></span>
      <PeachMark class="home-hero__mark" />
    </div>
  </div>
</section>

<style>
  .home-hero {
    display: grid;
    align-items: center;
    padding-block: var(--space-l) var(--space-2xl);
  }

  /* A full first screen on tablets and up; phones start the story right away. */
  @media (min-width: 48em) {
    .home-hero {
      min-block-size: min(100svh - var(--header-h), 54rem);
      padding-block-start: var(--space-xl);
    }
  }

  .home-hero__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .home-hero__text {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .home-hero__lede {
    max-width: 40ch;
  }

  .home-hero__actions {
    --cluster-gap: var(--space-xs) var(--space-s);
    margin-top: var(--space-2xs);
  }

  .home-hero__art {
    position: relative;
    display: none;
    place-items: center;
  }

  .home-hero__sun {
    position: absolute;
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    background: radial-gradient(circle at 50% 45%, var(--blush), transparent 68%);
  }

  .home-hero__art :global(.home-hero__mark) {
    position: relative;
    width: 58%;
    filter: drop-shadow(0 24px 30px rgb(var(--espresso-rgb) / 0.14));
  }

  @media (min-width: 64em) {
    .home-hero__inner {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    }

    .home-hero__art {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-hero__art :global(.home-hero__mark) {
      animation: hero-float 5s var(--ease-in-out) infinite alternate;
    }

    @keyframes hero-float {
      from {
        translate: 0 0.6rem;
        rotate: -2deg;
      }
    }
  }
</style>
