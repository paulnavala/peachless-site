---
import Tagline from './Tagline.astro';
import WorkReel, { type ReelTile } from './WorkReel.astro';

interface Props {
  eyebrow?: string;
  line1: string;
  line2: string;
  lede?: string;
  primary: { label: string; link: string };
  secondary?: { label: string; link: string };
  /** Work the rest of the page doesn't show yet (see reelPicks). */
  reel: ReelTile[];
}
const { eyebrow, line1, line2, lede, primary, secondary, reel } = Astro.props;
---
<script is:inline>
  // The hero plays once per session: the headline types, the introduction and
  // the reel arrive. Set before any of it is parsed, so a returning visitor
  // never sees it restart.
  try {
    if (sessionStorage.getItem('peachless:tagline')) document.documentElement.dataset.taglineSeen = '';
    else sessionStorage.setItem('peachless:tagline', '1');
  } catch {}
</script>
<section class="home-hero" aria-label="Introduction">
  <div class="container home-hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Tagline line1={line1} line2={line2} />
    <div class="home-hero__foot">
      {lede && <p class="lede home-hero__lede">{lede}</p>}
      <div class="cluster home-hero__actions">
        <a class="btn btn--lg" href={primary.link}>{primary.label}</a>
        {secondary && <a class="btn btn--secondary btn--lg" href={secondary.link}>{secondary.label}</a>}
      </div>
    </div>
  </div>
  {reel.length >= 3 && <WorkReel tiles={reel} />}
</section>

<style>
  .home-hero {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-l-2xl);
    padding-block: var(--space-l) var(--space-xl);
    /* The reel drifts on this timeline as the hero scrolls away. */
    view-timeline-name: --hero;
    view-timeline-axis: block;
    view-timeline-inset: 0px;
  }

  /* A full first screen on tablets and up; phones start the story right away. */
  @media (min-width: 48em) {
    .home-hero {
      min-block-size: min(100svh - var(--header-h), 54rem);
      padding-block-start: var(--space-xl);
    }
  }

  .home-hero__inner {
    display: grid;
    gap: var(--space-m);
    align-content: center;
    justify-items: start;
  }

  .home-hero__foot {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    margin-top: var(--space-2xs);
  }

  .home-hero__lede {
    max-width: 40ch;
  }

  .home-hero__actions {
    --cluster-gap: var(--space-xs) var(--space-s);
  }

  @media (min-width: 64em) {
    .home-hero__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--space-xl);
      width: 100%;
    }
  }

  /* First visit: the introduction settles in while the headline types, so the
     calls to action are ready long before the last letter. The headline (the
     LCP) is never held back. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-tagline-seen])) .home-hero :is(.eyebrow, .home-hero__lede, .home-hero__actions) {
      animation: hero-in var(--duration-slower) var(--ease-out) both;
    }

    :global(html:not([data-tagline-seen])) .home-hero__lede {
      animation-delay: var(--duration-slow);
    }

    :global(html:not([data-tagline-seen])) .home-hero__actions {
      animation-delay: calc(var(--duration-slow) + 2 * var(--stagger));
    }

    @keyframes hero-in {
      from {
        opacity: 0;
        translate: 0 var(--reveal-shift);
      }
    }
  }
</style>
