---
// "Through my lens": a loose collage of photos, each floating at its own depth
// as the band scrolls past (data-scroll="drift" on the band's timeline).
import type { Photo } from '../../lib/content';
import Media from '../ui/Media.astro';

interface Props {
  photos: Photo[];
}
const { photos } = Astro.props;
// Depth per tile (the lead photo anchors the composition).
const DRIFT = ['0rem', '2.5rem', '-1.5rem', '-1rem', '3rem'];
---
<ul class="photo-strip" role="list" data-count={photos.length}>
  {
    photos.map((photo, i) => (
      <li
        class:list={['photo-strip__item', { 'photo-strip__item--lead': i === 0 }]}
        data-reveal
        data-scroll="drift"
        style={{ '--reveal-index': i, '--drift': DRIFT[i % DRIFT.length] }}
      >
        <a class="photo-strip__link" href="/photography/" data-cursor="View">
          <Media
            image={photo.data.image}
            alt={photo.data.alt}
            sizes={i === 0 ? '(min-width: 64em) 31rem, 100vw' : '(min-width: 64em) 24rem, 50vw'}
          />
          <span class="photo-strip__title">{photo.data.title}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .photo-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
    margin: 0;
    /* The tiles drift on the band's own timeline. */
    view-timeline-name: --lens;
    view-timeline-axis: block;
    view-timeline-inset: 0px;
    --drift-timeline: --lens;
  }

  .photo-strip__item--lead {
    grid-column: 1 / -1;
  }

  @media (min-width: 64em) {
    .photo-strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 15rem;
    }

    .photo-strip__item--lead {
      grid-column: span 2;
      grid-row: span 2;
    }

    /* Five photos: an asymmetric collage on a 12-column grid. */
    .photo-strip[data-count='5'] {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: clamp(2.5rem, 3.6vw, 3.75rem);
      gap: 0 var(--space-s);
      padding-block: var(--space-m);
    }

    /* The lead ends on the same line as Sunset and Stairway: the collage's
       foot is one clean edge, its top a deliberate stagger. */
    .photo-strip[data-count='5'] > :nth-child(1) {
      grid-column: 1 / 6;
      grid-row: 1 / 12;
    }

    .photo-strip[data-count='5'] > :nth-child(2) {
      grid-column: 7 / 10;
      grid-row: 2 / 8;
    }

    .photo-strip[data-count='5'] > :nth-child(3) {
      grid-column: 10 / 13;
      grid-row: 1 / 6;
    }

    .photo-strip[data-count='5'] > :nth-child(4) {
      grid-column: 6 / 10;
      grid-row: 9 / 12;
    }

    .photo-strip[data-count='5'] > :nth-child(5) {
      grid-column: 10 / 13;
      grid-row: 7 / 12;
    }
  }

  .photo-strip__link {
    container-type: inline-size;
    position: relative;
    display: block;
    height: 100%;
    aspect-ratio: 4 / 3;
    overflow: clip;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 64em) {
    .photo-strip__link {
      aspect-ratio: auto;
    }
  }

  .photo-strip__link :global(picture) {
    height: 100%;
  }

  .photo-strip__title {
    position: absolute;
    left: var(--space-xs);
    bottom: var(--space-xs);
    padding: 0.3em 0.75em;
    border-radius: var(--radius-pill);
    background: rgb(var(--linen-rgb) / 0.9);
    color: var(--ink-strong);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
  }

  /* A small tile (the narrowest phones) gets a smaller label, still on one line. */
  @container (width < 10rem) {
    .photo-strip__title {
      left: var(--space-2xs);
      bottom: var(--space-2xs);
      font-size: var(--text-micro);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .photo-strip__link:is(:hover, :focus-visible) :global(.media) {
      scale: var(--hover-scale);
    }
  }
</style>
