---
// Renders a project's story: each block type maps to one component. Blocks
// sit on the .content-grid, so each can be content-, wide- or full-width.
// Every block with a heading is a numbered chapter with an anchor
// (src/lib/chapters.ts); the first text block opens the story in the serif.
import type { Project } from '../../lib/content';
import type { Chapter } from '../../lib/chapters';
import TextBlock from './TextBlock.astro';
import ImageBlock from './ImageBlock.astro';
import GalleryBlock from './GalleryBlock.astro';
import QuoteBlock from './QuoteBlock.astro';
import LogoBlock from './LogoBlock.astro';
import PaletteBlock from './PaletteBlock.astro';
import GuidelinesBlock from './GuidelinesBlock.astro';
import PrototypeEmbed from './PrototypeEmbed.astro';
import BeforeAfterBlock from './BeforeAfterBlock.astro';

type Block = Project['data']['blocks'][number];

interface Props {
  blocks: Block[];
  chapters: Chapter[];
  projectTitle: string;
  cover: Project['data']['cover'];
}
const { blocks, chapters, projectTitle, cover } = Astro.props;
const idOf = (i: number) => chapters.find((c) => c.block === i)?.id;
const lead = blocks.findIndex((b) => b.type === 'text');
---
<div class="story content-grid">
  {
    blocks.map((block, i) => {
      const id = idOf(i);
      switch (block.type) {
        case 'text':
          return <TextBlock id={id} heading={block.heading} body={block.body} lead={i === lead} />;
        case 'image':
          return <ImageBlock image={block.image} alt={block.alt} caption={block.caption} size={block.size} />;
        case 'gallery':
          return <GalleryBlock id={id} heading={block.heading} images={block.images} frame={block.frame} />;
        case 'quote':
          return <QuoteBlock quote={block.quote} attribution={block.attribution} />;
        case 'logo':
          return <LogoBlock id={id} heading={block.heading} caption={block.caption} variants={block.variants} />;
        case 'palette':
          return <PaletteBlock id={id} heading={block.heading} swatches={block.swatches} />;
        case 'guidelines':
          return <GuidelinesBlock id={id} heading={block.heading} pages={block.pages} projectTitle={projectTitle} />;
        case 'prototype':
          return (
            <PrototypeEmbed
              url={block.url}
              label={block.label}
              poster={block.poster || undefined}
              fallback={cover}
              projectTitle={projectTitle}
              frame={block.frame}
            />
          );
        case 'before-after':
          return <BeforeAfterBlock before={block.before} after={block.after} alt={block.alt} caption={block.caption} />;
      }
    })
  }
</div>

<style>
  .story {
    counter-reset: chapter;
    padding-block: var(--space-l-2xl) var(--space-2xl-4xl);
  }

  /* Chapter numbers: decoration only (the "/ ''" keeps them out of the
     accessible name), in the project's own ink. */
  .story :global(.block-heading)::before {
    counter-increment: chapter;
    content: counter(chapter, decimal-leading-zero) / '';
    display: block;
    margin-block-end: var(--space-2xs);
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: 0;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--project-ink, var(--color-accent-text));
  }

  .story > :global([id]) {
    scroll-margin-block-start: var(--space-m);
  }
</style>
