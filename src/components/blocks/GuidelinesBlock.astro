---
import type { ImageMetadata } from 'astro';
import GuidelineViewer from '../islands/GuidelineViewer.vue';
import { GUIDELINES_HEADING } from '../../lib/chapters';
import { evenColumns } from '../../lib/grid';
import '../../styles/components/guideline-viewer.css';

interface Props {
  heading?: string;
  pages: { title: string; image: ImageMetadata }[];
  projectTitle: string;
  /** Chapter anchor (src/lib/chapters.ts). */
  id?: string;
}
const { heading, pages, projectTitle, id } = Astro.props;
// Vue islands get plain strings and numbers (image metadata objects for SVGs
// are not serialisable). Pages are always shown as <img>, never inlined: every
// brand-book SVG uses the same .cls-N class names.
const viewerPages = pages.map((p) => ({ title: p.title, src: p.image.src, width: p.image.width, height: p.image.height }));
// Thumbnail columns (two on phones) that never leave a page alone on a row.
const columns = { '--gv-cols-md': evenColumns(pages.length, [4, 3]), '--gv-cols-lg': evenColumns(pages.length, [5, 4]) };
---
<section class="guidelines-block" id={id} style={columns}>
  <div class="guidelines-block__head">
    <h2 class="block-heading">{heading || GUIDELINES_HEADING}</h2>
    <p class="block-caption">{pages.length} pages — open any page to read the book full screen.</p>
  </div>
  <GuidelineViewer client:visible pages={viewerPages} label={`${projectTitle} brand book`} />
</section>

<style>
  /* The brand book on a full-bleed shelf in the project's colour. */
  .guidelines-block {
    grid-column: full;
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-xl-3xl);
    padding-inline: max(var(--gutter), (100% - var(--container-max)) / 2);
    background: var(--project-tint, var(--blush));
  }

  .guidelines-block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
  }
</style>
