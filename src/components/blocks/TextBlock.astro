---
import { renderMarkdown } from '../../lib/markdown';

interface Props {
  heading?: string;
  body: string;
  /** Chapter anchor (src/lib/chapters.ts). */
  id?: string;
  /** The story's opening: its first paragraph is set large, in the serif. */
  lead?: boolean;
}
const { heading, body, id, lead = false } = Astro.props;
---
<section class:list={['text-block is-wide', { 'text-block--lead': lead }]} id={id}>
  {heading && <h2 class="block-heading text-block__heading">{heading}</h2>}
  <div class="text-block__body flow" set:html={renderMarkdown(body)} />
</section>

<style>
  .text-block {
    display: grid;
    gap: var(--space-s);
  }

  .text-block__body {
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 38em;
    color: var(--color-text);
  }

  .text-block__body :global(p) {
    text-wrap: pretty;
  }

  /* Lists: an en dash (or the number) in the project's ink, hung outside the
     text so every line starts on the same edge. */
  .text-block__body :global(:is(ul, ol)) {
    padding-inline-start: 1.5em;
  }

  .text-block__body :global(li + li) {
    margin-block-start: 0.5em;
  }

  .text-block__body :global(ul) {
    list-style-type: '32';
  }

  .text-block__body :global(li::marker) {
    color: var(--project-ink, var(--color-accent-text));
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-semibold);
  }

  /* The story's opening paragraph, set as a standfirst in the serif (never
     below --text-h3, its smallest size). */
  .text-block--lead .text-block__body > :global(p:first-child) {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-medium);
    font-variant-numeric: oldstyle-nums;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--color-heading);
  }

  @media (min-width: 64em) {
    .text-block {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--space-xl);
    }

    .text-block__heading {
      position: sticky;
      top: calc(var(--header-h-condensed) + var(--space-l));
      align-self: start;
    }

    /* A text block without a heading still sits in the reading column. */
    .text-block__body:only-child {
      grid-column: 2;
    }
  }
</style>
