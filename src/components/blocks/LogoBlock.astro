---
import type { ImageMetadata } from 'astro';
import Media from '../ui/Media.astro';

interface Props {
  heading?: string;
  caption?: string;
  variants: { image: ImageMetadata; alt: string; label?: string; panel: string }[];
  /** Chapter anchor (src/lib/chapters.ts). */
  id?: string;
}
const { heading, caption, variants, id } = Astro.props;
---
<section class="logo-block is-wide" id={id}>
  {heading && <h2 class="block-heading">{heading}</h2>}
  <ul class="logo-block__grid" role="list" style={`--count: ${Math.min(variants.length, 3)}`}>
    {
      variants.map((v) => (
        <li>
          <figure class="logo-block__item">
            <div class="logo-block__panel" data-panel={v.panel}>
              <Media image={v.image} alt={v.alt} sizes="(min-width: 64em) 36rem, 100vw" fit="contain" />
            </div>
            {v.label && <figcaption class="block-caption">{v.label}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>
  {caption && <p class="logo-block__caption">{caption}</p>}
</section>

<style>
  .logo-block {
    display: grid;
    gap: var(--space-m);
  }

  .logo-block__grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
    margin: 0;
  }

  .logo-block__item {
    display: grid;
    gap: var(--space-xs);
  }

  .logo-block__panel {
    aspect-ratio: 4 / 3;
    overflow: clip;
    border-radius: var(--radius-xl);
    box-shadow:
      var(--shadow-sm),
      inset 0 0 0 1px rgb(var(--espresso-rgb) / 0.06);
    --panel-pad: 16%;
  }

  .logo-block__panel :global(picture) {
    height: 100%;
  }

  .logo-block__caption {
    max-width: 46ch;
    font-size: var(--step-1);
    color: var(--color-text-secondary);
  }

  @media (min-width: 48em) {
    .logo-block__grid {
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    }
  }
</style>
