---
// A Figma prototype behind a click-to-load facade: the page stays light until
// a visitor asks for the (multi-megabyte) embed. Fullscreen opens a <dialog>;
// "Open in Figma" always works, even where embeds don't.
import type { ImageMetadata } from 'astro';
import type { Frame } from '../../lib/content-schema';
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import DeviceFrame from '../ui/DeviceFrame.astro';

interface Props {
  url: string;
  label?: string;
  poster?: ImageMetadata;
  /** Shown when there is no poster: the project's cover on its panel. */
  fallback: { image: ImageMetadata; panel: string; fit: 'cover' | 'contain' };
  projectTitle: string;
  /** Show the prototype inside a phone (apps) or a browser window (websites). */
  frame?: Frame;
}
const { url, label, poster, fallback, projectTitle, frame = 'none' } = Astro.props;
const still = poster ? { image: poster, panel: 'none', fit: 'cover' as const } : fallback;
const embed = `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(url)}`;
const buttonLabel = label ?? `Try the ${projectTitle} prototype`;
// A phone keeps its screen's proportions; a window shows a 16:10 page.
const screen = frame === 'phone' && poster ? `${poster.width} / ${poster.height}` : frame === 'browser' ? '16 / 10' : undefined;
// The phone's width for each pixel of its height (screen plus DeviceFrame's
// 1.8cqi bezel; 9:19.5 without a poster), so it can be sized to fit the window.
const screenTall = poster ? poster.height / poster.width : 19.5 / 9;
const phoneFit = (1 / (0.964 * screenTall + 0.036)).toFixed(4);
const stillSizes = frame === 'phone' ? '(min-width: 48em) 22rem, 80vw' : '(min-width: 75rem) 75rem, 100vw';
---
<figure class:list={['proto is-wide', `proto--${frame}`]} data-prototype data-embed={embed} data-title={projectTitle}>
  {
    frame === 'none' ? (
      <div class="proto__screen">
        <div class="proto__frame" data-proto-frame data-panel={still.panel}>
          <Media class="proto__still" image={still.image} alt="" sizes={stillSizes} fit={still.fit} />
        </div>
        <div class="proto__facade" data-proto-facade>
          <button class="btn btn--accent btn--lg" type="button" data-proto-launch>
            <Icon name="play" />
            {buttonLabel}
          </button>
          <p class="proto__note">Loads an interactive Figma prototype.</p>
        </div>
      </div>
    ) : frame === 'browser' ? (
      <div class="proto__screen">
        <DeviceFrame frame="browser" ratio={screen} caption={projectTitle}>
          <div class="proto__frame" data-proto-frame data-panel={still.panel}>
            <Media class="proto__still" image={still.image} alt="" sizes={stillSizes} fit={still.fit} />
          </div>
        </DeviceFrame>
        <div class="proto__facade" data-proto-facade>
          <button class="btn btn--accent btn--lg" type="button" data-proto-launch>
            <Icon name="play" />
            {buttonLabel}
          </button>
          <p class="proto__note">Loads an interactive Figma prototype.</p>
        </div>
      </div>
    ) : (
      <div class="proto__stage">
        <DeviceFrame frame="phone" ratio={screen} class="proto__phone" style={{ '--phone-fit': phoneFit }}>
          <div class="proto__frame" data-proto-frame data-panel={still.panel}>
            <Media class="proto__still" image={still.image} alt="" sizes={stillSizes} fit={still.fit} />
          </div>
        </DeviceFrame>
        <div class="proto__aside" data-proto-facade>
          <p class="proto__lead">Try it yourself — every screen is clickable.</p>
          <button class="btn btn--accent btn--lg" type="button" data-proto-launch>
            <Icon name="play" />
            {buttonLabel}
          </button>
          <p class="proto__note">Loads an interactive Figma prototype in the phone.</p>
        </div>
      </div>
    )
  }
  <figcaption class="proto__bar">
    <span class="proto__caption">Interactive Figma prototype</span>
    <span class="cluster proto__actions">
      <button class="btn btn--secondary btn--sm" type="button" data-proto-fullscreen aria-haspopup="dialog">
        Fullscreen
        <Icon name="expand" />
      </button>
      <a class="link-arrow" href={url} target="_blank" rel="noopener">
        Open in Figma
        <Icon name="arrow-up-right" />
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </span>
  </figcaption>
  <dialog class="proto-dialog" aria-label={`${projectTitle} prototype`} data-proto-dialog>
    <div class="proto-dialog__bar">
      <p class="proto-dialog__title">{projectTitle}</p>
      <span class="cluster">
        <a class="link-arrow" href={url} target="_blank" rel="noopener">
          Open in Figma
          <Icon name="arrow-up-right" />
          <span class="sr-only">(opens in a new tab)</span>
        </a>
        <button class="btn btn--accent btn--sm" type="button" data-proto-close>
          Close
          <Icon name="close" />
        </button>
      </span>
    </div>
    <iframe class="proto-dialog__frame" title={`${projectTitle} prototype, full screen`} allow="fullscreen; clipboard-write" allowfullscreen></iframe>
  </dialog>
</figure>

<script>
  import { lockScroll, trapFocus } from '../../lib/dom';

  document.querySelectorAll<HTMLElement>('[data-prototype]').forEach((root) => {
    const embed = root.dataset.embed ?? '';
    const title = root.dataset.title ?? 'Prototype';
    const frame = root.querySelector<HTMLElement>('[data-proto-frame]')!;
    const dialog = root.querySelector<HTMLDialogElement>('[data-proto-dialog]')!;
    const dialogFrame = dialog.querySelector<HTMLIFrameElement>('iframe')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-proto-close]')!;
    let release: (() => void) | null = null;
    let unlock: (() => void) | null = null;
    let opener: HTMLElement | null = null;

    // Inline: load the live embed over the still. The facade says it is
    // loading until the prototype has painted, then the embed fades in and the
    // facade (in the frame, or beside a phone) has done its job. Figma can be
    // slow; after a few seconds the embed shows whatever it has.
    root.querySelector('[data-proto-launch]')?.addEventListener('click', () => {
      const facade = root.querySelector<HTMLElement>('[data-proto-facade]');
      const iframe = document.createElement('iframe');
      iframe.className = 'proto__iframe';
      iframe.title = `${title} prototype`;
      iframe.allow = 'fullscreen; clipboard-write';
      iframe.allowFullscreen = true;
      const shown = () => {
        if (iframe.hasAttribute('data-loaded')) return;
        iframe.dataset.loaded = '';
        facade?.remove();
      };
      iframe.addEventListener('load', shown, { once: true });
      setTimeout(shown, 6000);
      iframe.src = embed;
      if (facade) {
        const note = document.createElement('p');
        note.className = 'proto__note proto__note--loading';
        note.setAttribute('role', 'status');
        note.textContent = 'Loading the prototype…';
        facade.replaceChildren(note);
      }
      frame.append(iframe);
      frame.dataset.live = '';
      iframe.focus();
    });

    // Fullscreen dialog.
    root.querySelector<HTMLButtonElement>('[data-proto-fullscreen]')?.addEventListener('click', (e) => {
      opener = e.currentTarget as HTMLElement;
      dialogFrame.addEventListener(
        'load',
        () => {
          // The cross-origin embed grabs focus when it loads, which would route
          // Escape into the iframe. Take it back once; visitors who click into
          // the prototype keep their focus.
          if (dialog.open && document.activeElement === dialogFrame) closeBtn.focus();
        },
        { once: true }
      );
      dialogFrame.src = embed;
      dialog.showModal();
      unlock = lockScroll('dark');
      release = trapFocus(dialog, 'a[href], button, iframe');
      closeBtn.focus();
    });
    closeBtn.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      dialogFrame.src = 'about:blank';
      release?.();
      unlock?.();
      release = unlock = null;
      opener?.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .proto {
    display: grid;
    gap: var(--space-xs);
  }

  .proto__frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: clip;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    --panel-pad: 12% 26% 24%;
  }

  .proto__frame :global(picture),
  .proto__frame :global(.media) {
    width: 100%;
    height: 100%;
  }

  /* A cropped still is a screenshot: keep its top (the page's own header)
     in view, like a browser would. */
  .proto__frame :global(.media--cover) {
    object-position: top;
  }

  /* Long button labels wrap instead of overflowing narrow screens. */
  .proto :global(.btn) {
    white-space: normal;
  }

  /* Inside a device the frame fills the screen. */
  .proto--browser .proto__frame,
  .proto--phone .proto__frame {
    aspect-ratio: auto;
    height: 100%;
    border-radius: 0;
    box-shadow: none;
  }

  /* Phone: the device on one side, the invitation on the other. */
  .proto__stage {
    display: grid;
    gap: var(--space-l);
    justify-items: center;
  }

  /* The phone you try the prototype in fits the window whole, under the header. */
  .proto__stage :global(.proto__phone) {
    inline-size: min(100%, 20rem, (100svh - var(--header-h-condensed) - var(--space-xl)) * var(--phone-fit));
  }

  .proto__aside {
    display: grid;
    gap: var(--space-s);
    justify-items: center;
    max-width: 26rem;
    text-align: center;
  }

  .proto__lead {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: var(--weight-display-sm);
    line-height: var(--leading-heading);
    color: var(--color-heading);
    text-wrap: balance;
  }

  @media (min-width: 48em) {
    .proto__stage {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      align-items: center;
      justify-items: start;
      gap: var(--space-2xl);
    }

    .proto__aside {
      justify-items: start;
      text-align: start;
    }
  }

  /* The launch control: under a small still (a phone), so the whole picture
     stays in view; over a larger one, floating in a frosted card that reads on
     photos and on light logo panels alike. */
  .proto__screen {
    position: relative;
    container-type: inline-size;
    display: grid;
    gap: var(--space-s);
  }

  .proto__facade {
    display: grid;
    justify-items: center;
    gap: var(--space-2xs);
    text-align: center;
  }

  .proto__note,
  .proto :global(.proto__note--loading) {
    font-size: var(--text-small);
    color: var(--cacao);
  }

  /* Under the still: a standard-size button (a long label stays on one line on
     a phone), and no note, since the caption below already says what it is. */
  @container (width < 32rem) {
    .proto__facade .btn {
      min-height: 2.75rem;
      padding: 0.65em 1.35em;
      font-size: var(--text-ui);
    }

    .proto__facade .proto__note {
      display: none;
    }
  }

  @container (min-width: 32rem) {
    .proto__facade {
      position: absolute;
      inset: auto 0 var(--space-m);
      z-index: var(--z-raised);
      width: fit-content;
      margin-inline: auto;
      padding: var(--space-s) var(--space-m);
      border-radius: var(--radius-xl);
      background: rgb(var(--linen-rgb) / 0.82);
      -webkit-backdrop-filter: blur(12px) saturate(1.3);
      backdrop-filter: blur(12px) saturate(1.3);
      box-shadow: var(--shadow-md);
    }

    /* Dim a photographic still only while the launch card sits on it. */
    .proto__screen:has(> [data-proto-facade]) [data-panel='none'] :global(.proto__still) {
      filter: saturate(0.85) brightness(0.8);
    }

    @media (prefers-reduced-transparency: reduce) {
      .proto__facade {
        background: var(--linen);
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }
    }
  }

  /* The live embed lies over the still and fades in once it has painted. */
  .proto__frame :global(.proto__iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .proto__frame :global(.proto__iframe) {
      transition: opacity var(--duration-slow) var(--ease-out);
    }

    .proto__frame :global(.proto__iframe:not([data-loaded])) {
      opacity: 0;
    }

    .proto :global(.proto__note--loading) {
      animation: proto-wait 1.2s var(--ease-in-out) infinite alternate;
    }

    @keyframes proto-wait {
      to {
        opacity: 0.45;
      }
    }
  }

  .proto__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .proto__actions {
    --cluster-gap: var(--space-xs) var(--space-m);
  }

  .proto-dialog {
    width: 100vw;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    background: var(--espresso);
    color: var(--linen);
    --focus-ring: var(--clay);
    --color-link: var(--linen);
    --color-link-hover: var(--clay);
  }

  .proto-dialog[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .proto-dialog::backdrop {
    background: var(--espresso);
  }

  .proto-dialog__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--gutter);
  }

  .proto-dialog__title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-display-sm);
  }

  .proto-dialog__frame {
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--espresso-raised);
  }
</style>
