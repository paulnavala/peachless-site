---
import Media from '../ui/Media.astro';
import LitStatement from '../ui/LitStatement.astro';
import { TOOL_LABELS } from '../../lib/content-schema';
import { renderMarkdown } from '../../lib/markdown';
import type { SectionProps } from '../../lib/pages';

type Props = SectionProps<'profile'>;
const { section, data, last: _last, aboveFold: _aboveFold, class: className, ...rest } = Astro.props;
const { eyebrow, title, statement, body, resumeLabel, processHeading, process: steps, toolsHeading, toolsNote, experienceHeading, experience, closing } = section;
const { portrait, portraitAlt, resume, tools } = data;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class:list={['section about', className]} {...rest}>
  <div class="container about__inner">
    <div class="about__portrait about-portrait">
      <Media image={portrait} alt={portraitAlt} sizes="(min-width: 64em) 30rem, 90vw" priority />
    </div>
    <div class="about__text">
      {eyebrow && <p class="eyebrow" data-field="eyebrow">{eyebrow}</p>}
      <h1 class="about__title" data-field="title">{title}</h1>
      <p class="about__statement t-quote" data-field="statement">{statement}</p>
      <div class="about__body flow" data-field="body" set:html={renderMarkdown(body)} />
      {resume && <a class="btn btn--secondary about__resume" href={resume} download data-field="resumeLabel">{resumeLabel}</a>}
      {
        steps.length > 0 && (
          <section class="about-section" aria-labelledby="about-process">
            <h2 id="about-process" class="t-h2" data-field="processHeading">{processHeading}</h2>
            <ol class="about-steps" role="list">
              {steps.map((step, i) => (
                <li>
                  <span class="about-steps__num" aria-hidden="true">{pad(i + 1)}</span>
                  <div>
                    <h3 data-field={`process.${i}.title`}>{step.title}</h3>
                    <p data-field={`process.${i}.body`}>{step.body}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )
      }
      {
        tools.length > 0 && (
          <section class="about-section" aria-labelledby="about-tools">
            <h2 id="about-tools" class="t-h2" data-field="toolsHeading">{toolsHeading}</h2>
            {toolsNote && <p class="about-section__note" data-field="toolsNote">{toolsNote}</p>}
            <ul class="cluster about-tools" role="list">
              {tools.map(({ tool, count }) => (
                <li>
                  <a class="chip" href={`/projects/tools/${tool}/`}>
                    {TOOL_LABELS[tool]}
                    <span class="chip__count">{count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        experience.length > 0 && (
          <section class="about-section" aria-labelledby="about-experience">
            <h2 id="about-experience" class="t-h2" data-field="experienceHeading">{experienceHeading}</h2>
            <ul class="about-experience" role="list">
              {experience.map((entry, i) => (
                <li>
                  <span class="about-experience__period" data-field={`experience.${i}.period`}>{entry.period}</span>
                  <span class="about-experience__role" data-field={`experience.${i}.role`}>{entry.role}</span>
                  {entry.place && <span class="about-experience__place" data-field={`experience.${i}.place`}>{entry.place}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {closing && <LitStatement tag="p" class="about__closing" text={closing} data-field="closing" />}
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    gap: var(--space-xl);
  }

  /* An arch, like the home page's portrait (they morph into each other). */
  .about__portrait {
    width: min(100%, 26rem);
    aspect-ratio: 4 / 5;
    overflow: clip;
    border-radius: 50% 50% var(--radius-lg) var(--radius-lg) / 40% 40% var(--radius-lg) var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .about__portrait :global(picture) {
    height: 100%;
  }

  .about__text {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .about__title {
    font-size: var(--text-h1);
  }

  .about__statement {
    max-width: 26ch;
    color: var(--color-heading);
  }

  .about__body {
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--color-text-secondary);
  }

  .about__resume {
    justify-self: start;
  }

  .about-section {
    display: grid;
    gap: var(--space-s);
    margin-block-start: var(--space-m);
  }

  .about-section__note {
    color: var(--color-text-secondary);
  }

  .about-steps,
  .about-experience {
    display: grid;
    gap: var(--space-s);
    margin: 0;
  }

  .about-steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-s);
    align-items: baseline;
  }

  .about-steps__num {
    color: var(--color-accent-text);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .about-steps p {
    max-width: var(--measure);
    margin-block-start: var(--space-3xs);
    color: var(--color-text-secondary);
  }

  .about-tools {
    margin: 0;
    --cluster-gap: var(--space-2xs);
  }

  .about-experience li {
    display: grid;
    gap: 0 var(--space-m);
  }

  .about-experience__period {
    color: var(--color-text-muted);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .about-experience__role {
    font-weight: var(--weight-medium);
  }

  .about-experience__place {
    color: var(--color-text-secondary);
  }

  @media (min-width: 36em) {
    .about-experience li {
      grid-template-columns: 9rem minmax(0, 1fr);
    }

    .about-experience__period {
      grid-row: span 2;
    }

    .about-experience__place {
      grid-column: 2;
    }
  }

  /* The page ends on the tagline, lit word by word as it scrolls up: balanced,
     and wide enough to break between its two sentences. */
  .about__closing {
    max-width: 22ch;
    text-wrap: balance;
    margin-block-start: var(--space-l);
    font-family: var(--font-display);
    font-size: var(--text-display-2);
    font-style: italic;
    line-height: var(--leading-heading);
    color: var(--color-accent-text);
  }

  @media (min-width: 64em) {
    .about__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
      align-items: start;
    }

    /* Sticky, so it must fit under the header whole: on a short window the
       arch (4:5) narrows until its foot clears the bottom edge. */
    .about__portrait {
      position: sticky;
      top: calc(var(--header-h-condensed) + var(--space-l));
      width: min(100%, (100svh - var(--header-h-condensed) - 2 * var(--space-l)) * 0.8);
    }
  }
</style>
