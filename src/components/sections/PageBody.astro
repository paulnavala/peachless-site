---
// A page's sections, in the order its document gives them. Core sections are
// imported here, so their CSS is on every route; each route passes in its own
// `bound` sections, so theirs stays on that route (see section-catalogue.ts).
// Nothing wraps a section: `.sheet + .sheet` needs them to be siblings.
import AboutTeaser from './AboutTeaser.astro';
import ClosingLinks from './ClosingLinks.astro';
import Deck from './Deck.astro';
import Disciplines from './Disciplines.astro';
import Manifesto from './Manifesto.astro';
import PageHeader from './PageHeader.astro';
import PhotoBand from './PhotoBand.astro';
import type { PlannedSection } from '../../lib/pages';

interface Props {
  plan: PlannedSection[];
  /** This route's own sections, by type. */
  bound?: Record<string, unknown>;
}
const { plan, bound = {} } = Astro.props;

type SectionComponent = (props: Record<string, unknown>) => unknown;
const components = {
  'page-header': PageHeader,
  manifesto: Manifesto,
  deck: Deck,
  disciplines: Disciplines,
  'photo-strip': PhotoBand,
  'about-teaser': AboutTeaser,
  'cta-band': ClosingLinks,
  ...bound,
} as unknown as Record<string, SectionComponent>;
---
{
  plan.map(({ section, data, last, aboveFold, root }) => {
    const Section = components[section.type];
    return (
      <Section
        section={section}
        data={data}
        last={last}
        aboveFold={aboveFold}
        class={section.sheet ? 'sheet' : undefined}
        {...root}
      />
    );
  })
}

<style is:global>
  /* An editor's spacing choices, which win over a section's own. */
  .section[data-space-top='tight'],
  .cta-band[data-space-top='tight'] {
    padding-block-start: var(--section-pad-tight);
  }

  .section[data-space-top='none'],
  .cta-band[data-space-top='none'] {
    padding-block-start: 0;
  }

  .section[data-space-bottom='tight'],
  .cta-band[data-space-bottom='tight'] {
    padding-block-end: var(--section-pad-tight);
  }

  .section[data-space-bottom='none'],
  .cta-band[data-space-bottom='none'] {
    padding-block-end: 0;
  }
</style>
