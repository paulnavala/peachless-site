---
import Media from '../ui/Media.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import type { SectionProps } from '../../lib/pages';

type Props = SectionProps<'about-teaser'>;
const { section, data, last = false, aboveFold = false, class: className, ...rest } = Astro.props;
const { id, heading, body, linkLabel } = section;
const { portrait, portraitAlt } = data;
const titleId = `${id}-title`;
---
<section
  class:list={['section about-teaser', className]}
  aria-labelledby={titleId}
  data-next-step={last ? '' : undefined}
  {...rest}
>
  <div class="container about-teaser__inner">
    <div
      class="about-teaser__portrait about-portrait"
      {...(aboveFold ? {} : { 'data-reveal': '', 'data-scroll': 'unveil', style: '--unveil-inset: 30% 0 0' })}
    >
      <Media image={portrait} alt={portraitAlt} sizes="(min-width: 64em) 28rem, 80vw" priority={aboveFold} />
    </div>
    <div class="about-teaser__text" {...(aboveFold ? {} : { 'data-reveal': '', style: '--reveal-index: 1' })}>
      <h2 id={titleId} class="about-teaser__title" data-field="heading">{heading}</h2>
      <p class="t-quote about-teaser__body" data-field="body">{body}</p>
      <ArrowLink href="/about/" data-field="linkLabel">{linkLabel}</ArrowLink>
    </div>
  </div>
</section>

<style>
  .about-teaser__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  /* An arch: on a 4:5 frame these radii draw a true semicircle on top. */
  .about-teaser__portrait {
    --arch: 50% 50% var(--radius-lg) var(--radius-lg) / 40% 40% var(--radius-lg) var(--radius-lg);
    width: min(100%, 24rem);
    aspect-ratio: 4 / 5;
    overflow: clip;
    border-radius: var(--arch);
    box-shadow: var(--shadow-md);
  }

  .about-teaser__portrait :global(picture) {
    height: 100%;
  }

  .about-teaser__text {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .about-teaser__title {
    font-size: var(--text-h2);
  }

  .about-teaser__body {
    max-width: 30ch;
    color: var(--color-text-secondary);
  }

  @media (min-width: 48em) {
    .about-teaser__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
    }

    .about-teaser__portrait {
      width: 100%;
    }
  }
</style>
