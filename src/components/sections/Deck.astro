---
import SectionHeader from '../ui/SectionHeader.astro';
import StoryDeck from '../home/StoryDeck.astro';
import type { SectionProps } from '../../lib/pages';

type Props = SectionProps<'deck'>;
const { section, data, last: _last, aboveFold = false, class: className, ...rest } = Astro.props;
const { id, heading, intro, action } = section;
const titleId = `${id}-title`;
---
<section class:list={['section selected-work', className]} aria-labelledby={titleId} {...rest}>
  <div class="container">
    <SectionHeader id={titleId} title={heading} lede={intro} action={action && { href: action.link, label: action.label }} />
    <StoryDeck projects={data.projects} aboveFold={aboveFold} />
  </div>
</section>
