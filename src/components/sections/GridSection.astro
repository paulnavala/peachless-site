---
// A custom section: an editor's elements on a 12-column grid. Its HTML comes from
// grid-plan.ts, which the builder's canvas shares, so the styles below are global:
// the canvas writes this markup with no Astro scope on it.
import type { ImageMetadata } from 'astro';
import Media from '../ui/Media.astro';
import { attrsHtml, itemHtml, planGrid } from '../../lib/grid-plan';
import type { SectionProps } from '../../lib/pages';

type Props = SectionProps<'grid'>;
const { section, data, last = false, aboveFold = false, class: className, ...rest } = Astro.props;
const plan = planGrid(section.elements, { opener: data.opener, aboveFold });
const hasButton = section.elements.some((element) => element.type === 'button');
---
<section
  class:list={['section grid-section', className]}
  data-next-step={last && hasButton ? '' : undefined}
  {...rest}
>
  <div class:list={['container', { 'container--wide': section.width === 'wide' }]}>
    <div class="grid-section__grid">
      {
        plan.map((planned) =>
          planned.element.type === 'image' ? (
            <div {...planned.attrs}>
              <figure class="grid-figure">
                <div class="grid-figure__media">
                  <Media
                    image={planned.element.image as unknown as ImageMetadata}
                    alt={planned.element.alt}
                    sizes={planned.sizes}
                    fit={planned.element.fit}
                    priority={aboveFold}
                  />
                </div>
                {planned.element.caption && <figcaption class="grid-figure__caption" data-field="caption">{planned.element.caption}</figcaption>}
              </figure>
            </div>
          ) : (
            <Fragment set:html={itemHtml(planned, () => '')} />
          )
        )
      }
    </div>
  </div>
</section>

<style is:global>
  .grid-section__grid {
    --grid-row: var(--space-l);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    /* A minimum, so words can always push a row taller and never clip. */
    grid-auto-rows: minmax(var(--grid-row), auto);
    gap: var(--space-s);
  }

  .grid-item {
    min-width: 0;
    grid-column: var(--col) / span var(--w);
    grid-row: var(--row) / span var(--h);
  }

  .grid-item[data-align='center'] {
    text-align: center;
    justify-self: center;
  }

  .grid-item[data-align='end'] {
    text-align: end;
    justify-self: end;
  }

  .grid-item[data-valign='center'] {
    align-self: center;
  }

  .grid-item[data-valign='end'] {
    align-self: end;
  }

  /* Phones: two columns, in reading order. An element takes both unless the
     editor chose half. */
  @media (width < 48em) {
    .grid-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
    }

    .grid-item {
      grid-column: span 2;
      grid-row: auto;
      order: var(--phone-order, 0);
    }

    .grid-item[data-phone-span='half'] {
      grid-column: span 1;
    }

    .grid-item[data-phone-hidden] {
      display: none;
    }

    .grid-figure__media {
      aspect-ratio: var(--ratio);
    }
  }

  .grid-heading {
    overflow-wrap: break-word;
  }

  /* The serif stays at --text-h3 and up, so the smallest look is Inter. */
  .grid-heading[data-style='statement'] {
    font-size: var(--text-statement);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .grid-heading[data-style='h1'] {
    font-size: var(--text-h1);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .grid-heading[data-style='h2'] {
    font-size: var(--text-h2);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-heading);
  }

  .grid-heading[data-style='h3'] {
    font-size: var(--text-h3);
    font-weight: var(--weight-display-sm);
    letter-spacing: 0;
  }

  .grid-heading[data-style='h4'] {
    font-family: var(--font-body);
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: 0;
  }

  .grid-text {
    max-width: var(--measure);
    overflow-wrap: break-word;
  }

  .grid-text[data-size='lede'] {
    font-size: var(--text-lede);
    color: var(--color-text-secondary);
  }

  .grid-text[data-size='small'] {
    font-size: var(--text-small);
  }

  .grid-figure {
    display: grid;
    gap: var(--space-2xs);
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100%;
    margin: 0;
  }

  /* An image fills the rows it was given. It must not size them: an auto row
     would grow to the picture's natural height and push the page apart. */
  .grid-figure__media {
    position: relative;
    min-height: 0;
    overflow: clip;
    border-radius: var(--radius-lg);
  }

  .grid-figure__media > :is(picture, img) {
    position: absolute;
    inset: 0;
  }

  .grid-figure__media .media {
    width: 100%;
    height: 100%;
  }

  .grid-figure__caption {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .grid-quote {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
  }

  .grid-quote__by {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .grid-divider {
    width: 100%;
    margin: 0;
    border: 0;
    border-block-start: 1px solid var(--color-border);
  }

  .grid-item--divider {
    align-self: center;
  }
</style>
