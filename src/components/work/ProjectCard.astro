---
import type { Project } from '../../lib/content';
import { DISCIPLINE_LABELS } from '../../lib/content-schema';
import Media from '../ui/Media.astro';

interface Props {
  project: Project;
  headingLevel?: 2 | 3;
  /** Layout width hint for the cover image. */
  sizes?: string;
  priority?: boolean;
  /** Larger, wider treatment (first card of the featured grid). */
  feature?: boolean;
}
const { project, headingLevel = 2, sizes = '(min-width: 64em) 38rem, (min-width: 36em) 50vw, 100vw', priority = false, feature = false } =
  Astro.props;
const { title, summary, disciplines, year, cover } = project.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const meta = [disciplines.map((d) => DISCIPLINE_LABELS[d]).join(' · '), year].filter(Boolean).join(' — ');
---
<article class:list={['project-card card', { 'project-card--feature': feature }]} data-testid="work-card">
  <div class="card__media project-card__media work-media" data-panel={cover.panel} style={`--vt: work-${project.id}`}>
    <Media image={cover.image} alt="" sizes={sizes} fit={cover.fit} priority={priority} />
  </div>
  <div class="project-card__body">
    <p class="project-card__meta">{meta}</p>
    <Heading class="project-card__title">
      <a class="card__link" href={`/projects/${project.id}/`}>{title}</a>
    </Heading>
    <p class="project-card__summary">{summary}</p>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  .project-card__media {
    --ratio: 4 / 3;
    --panel-pad: 16%;
    box-shadow: var(--shadow-sm);
  }

  .project-card--feature .project-card__media {
    --ratio: 3 / 2;
    --panel-pad: 12%;
  }

  .project-card__media :global(picture) {
    height: 100%;
  }

  .project-card__body {
    display: grid;
    gap: var(--space-2xs);
  }

  .project-card__meta {
    font-size: var(--text-micro);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .project-card__title {
    font-size: var(--step-3);
    line-height: var(--leading-heading);
  }

  .project-card--feature .project-card__title {
    font-size: var(--step-4);
  }

  .project-card__summary {
    color: var(--color-text-secondary);
    max-width: 52ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-card__media :global(.media) {
      transition: scale 600ms var(--ease-out);
    }

    .project-card:hover .project-card__media :global(.media) {
      scale: var(--hover-scale);
    }

    .project-card__title :global(a) {
      background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
      transition: background-size var(--duration-base) var(--ease-out);
    }

    .project-card:hover .project-card__title :global(a) {
      background-size: 100% 1px;
    }
  }
</style>
