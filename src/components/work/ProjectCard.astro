---
import type { Project } from '../../lib/content';
import { disciplineList } from '../../lib/content-schema';
import { projectTheme } from '../../lib/project-theme';
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  project: Project;
  headingLevel?: 2 | 3;
  /** Layout width hint for the cover image. */
  sizes?: string;
  priority?: boolean;
}
const { project, headingLevel = 2, sizes = '(min-width: 64em) 38rem, (min-width: 36em) 50vw, 100vw', priority = false } = Astro.props;
const { title, summary, disciplines, year, cover, accent } = project.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---
<article class="project-card card" data-testid="work-card" style={projectTheme(accent)}>
  <div
    class="card__media project-card__media work-media"
    data-panel={cover.panel}
    data-fit={cover.fit}
    data-scroll={cover.fit === 'cover' ? 'parallax' : undefined}
    data-cursor="View"
    style={{ '--vt': `work-${project.id}` }}
  >
    <div class="project-card__drift" data-scroll={cover.fit === 'contain' ? 'drift' : undefined}>
      <Media image={cover.image} alt="" sizes={sizes} fit={cover.fit} priority={priority} />
    </div>
  </div>
  <div class="project-card__body">
    <p class="project-card__meta">
      <span>{disciplineList(disciplines)}</span>
      {year && <span class="project-card__year">{year}</span>}
    </p>
    <Heading class="project-card__title work-title" style={{ '--vt-title': `work-title-${project.id}` }}>
      <a class="card__link" href={`/projects/${project.id}/`}>{title}</a>
    </Heading>
    <p class="project-card__summary">{summary}</p>
    <span class="project-card__cta" aria-hidden="true">
      View case study
      <Icon name="arrow-right" />
    </span>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  .project-card__media {
    --ratio: 4 / 3;
    --panel-pad: 16%;
    box-shadow: var(--shadow-sm);
  }

  /* Scroll effects move this wrapper (a logo floats in its panel; a photo
     drifts inside its frame); the hover zoom stays on the image itself. */
  .project-card__drift {
    --drift: 0.75rem;
    height: 100%;
  }

  .project-card__drift :global(picture) {
    height: 100%;
  }

  .project-card__body {
    display: grid;
    gap: var(--space-2xs);
    justify-items: start;
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.75em;
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .project-card__year {
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .project-card__title {
    font-size: var(--text-title);
    font-weight: var(--weight-display-sm);
    line-height: var(--leading-heading);
    letter-spacing: 0;
  }

  .project-card__summary {
    color: var(--color-text-secondary);
    max-width: 52ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .project-card__cta :global(svg) {
    width: 1em;
    height: 1em;
  }

  /* On hover devices the cue waits for the card, and the title underlines
     (in from the left, out to the right, like every quiet link). */
  @media (hover: hover) {
    .project-card__cta {
      opacity: 0;
    }

    .project-card:is(:hover, :focus-within) .project-card__cta {
      opacity: 1;
    }

    .project-card__title :global(a) {
      background: linear-gradient(currentColor, currentColor) 100% 100% / 0 1px no-repeat;
    }

    .project-card:is(:hover, :focus-within) .project-card__title :global(a) {
      background-position: 0 100%;
      background-size: 100% 1px;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-card:is(:hover, :focus-within) .project-card__media :global(.media) {
      scale: var(--hover-scale);
    }

    .project-card__title :global(a) {
      transition: background-size var(--duration-base) var(--ease-out);
    }

    .project-card:is(:hover, :focus-within) .project-card__cta :global(.icon) {
      translate: var(--nudge, none);
    }

    .project-card__cta {
      translate: -0.5rem 0;
      transition:
        opacity var(--duration-base) var(--ease-out),
        translate var(--duration-base) var(--ease-out);
    }

    .project-card:is(:hover, :focus-within) .project-card__cta {
      translate: 0 0;
    }
  }
</style>
