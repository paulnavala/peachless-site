---
// Work filters as plain links to pre-rendered pages: shareable, no JavaScript,
// and the current one is marked with aria-current. The pills choose the kind of
// work, the quieter "Made with" line a tool; one view is current across both.
// Each chip and the current chip's pill carry view-transition names, so moving
// between the filtered pages slides the pill from one chip to the next.
import { TOOL_LABELS, type Discipline, type Tool } from '../../lib/content-schema';
import type { WorkFilter } from '../../lib/pages';

interface Props {
  current: WorkFilter;
  counts: Partial<Record<'all' | Discipline, number>>;
  labels: { graphicDesign: string; uiux: string };
  /** The tools in use, in display order (toolCounts in lib/project-order.ts). */
  tools: { tool: Tool; count: number }[];
}
const { current, counts, labels, tools } = Astro.props;

type Chip = { key: WorkFilter; label: string; href: string; count?: number };
const kinds: Chip[] = [
  { key: 'all', label: 'All', href: '/projects/', count: counts.all },
  { key: 'uiux', label: labels.uiux, href: '/projects/uiux/', count: counts.uiux },
  { key: 'graphic-design', label: labels.graphicDesign, href: '/projects/graphic-design/', count: counts['graphic-design'] },
];
const made: Chip[] = tools.map(({ tool, count }) => ({
  key: tool,
  label: TOOL_LABELS[tool],
  href: `/projects/tools/${tool}/`,
  count,
}));
// One tool alone is no choice, unless it is the page being shown.
const showTools = made.length > 1 || made.some((chip) => chip.key === current);
const rows = [
  { name: 'kinds', chips: kinds },
  ...(showTools ? [{ name: 'tools', chips: made, label: 'Made with' }] : []),
] as { name: string; chips: Chip[]; label?: string }[];
---
<nav class="filter-chips" aria-label="Filter work">
  {
    rows.map(({ name, chips, label }) => (
      <div class={`filter-chips__row filter-chips__row--${name}`}>
        {label && <p id="filter-made-with" class="filter-chips__label">{label}</p>}
        <ul class:list={{ cluster: !label }} role="list" aria-labelledby={label ? 'filter-made-with' : undefined}>
          {chips.map((chip) => (
            <>
              <li>
                <a
                  class:list={['chip', { 'chip--quiet': label }]}
                  href={chip.href}
                  aria-current={chip.key === current ? 'page' : undefined}
                  style={`--vt-chip: chip-${chip.key}`}
                >
                  {chip.key === current && <span class="chip__indicator" aria-hidden="true" />}
                  {chip.label}
                  {chip.count !== undefined && <span class="chip__count">{chip.count}</span>}
                </a>
              </li>{' '}
            </>
          ))}
        </ul>
      </div>
    ))
  }
</nav>

<style>
  .filter-chips {
    container-type: inline-size;
    display: grid;
    gap: var(--space-2xs);
  }

  .filter-chips ul {
    margin: 0;
    --cluster-gap: var(--space-2xs);
  }

  /* On phones, tighter pills keep the three on one line. */
  @container (width < 24rem) {
    .filter-chips__row--kinds ul {
      --cluster-gap: var(--space-3xs);
    }

    .filter-chips__row--kinds .chip {
      padding-inline: 0.8em;
    }
  }

  /* Too narrow even so: All sits above the other two (never one pill alone at
     the end), each as wide as its column, so the block reads even. */
  @container (width < 19.5rem) {
    .filter-chips__row--kinds ul {
      display: grid;
      grid-template-columns: repeat(2, max-content);
    }

    .filter-chips__row--kinds li {
      display: grid;
    }

    .filter-chips__row--kinds li:first-child {
      grid-column: 1 / -1;
    }

    .filter-chips__row--kinds .chip {
      justify-content: center;
    }
  }

  /* The current chip's fill is its own element (the pill), so it can travel. */
  .filter-chips .chip {
    position: relative;
    overflow: clip;
    isolation: isolate;
  }

  .filter-chips .chip[aria-current] {
    background: transparent;
  }

  .chip__indicator {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--espresso);
  }

  /* "Made with": quieter than the pills, plain text until pointed at or chosen. */
  .filter-chips__row--tools {
    display: flex;
    align-items: baseline;
    gap: var(--space-3xs) var(--space-2xs);
  }

  .filter-chips__label {
    flex: none;
    font-size: var(--text-ui);
    color: var(--color-text-muted);
  }

  /* A run of chips set as text, so its lines balance (never a lone tool on the
     last line); the spaces between them are the gaps. */
  .filter-chips__row--tools ul {
    min-width: 0;
    text-wrap: balance;
    word-spacing: var(--space-3xs);
  }

  .filter-chips__row--tools li {
    display: inline;
  }

  .filter-chips .chip--quiet {
    min-height: 2.25rem;
    padding-inline: 0.75em;
    font-weight: var(--weight-regular);
    word-spacing: normal;
    white-space: nowrap;
  }

  /* Written around the current and hover states: unlayered, this would beat
     the .chip rules for both. */
  .filter-chips .chip--quiet:not([aria-current], :hover, :focus-visible) {
    border-color: transparent;
  }

  /* On phones the label sits above the tools, and the first tool's text lines
     up with it. */
  @container (width < 30rem) {
    .filter-chips__row--tools {
      display: grid;
    }

    .filter-chips__row--tools ul {
      margin-inline-start: -0.75em;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .filter-chips .chip {
      view-transition-name: var(--vt-chip);
      view-transition-class: chip;
    }

    .chip__indicator {
      view-transition-name: filter-indicator;
    }
  }

  @media (forced-colors: active) {
    .chip__indicator {
      forced-color-adjust: none;
      background: Highlight;
    }

    .filter-chips .chip[aria-current] {
      forced-color-adjust: none;
      color: HighlightText;
    }
  }
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    /* Labels ride above the sliding pill; the pill is clipped round at every width. */
    ::view-transition-group(*.chip) {
      z-index: var(--z-raised);
    }

    /* The pill travels from one chip to the next. */
    ::view-transition-group(filter-indicator) {
      overflow: clip;
      border-radius: var(--radius-pill);
      animation-duration: var(--duration-slow);
      animation-timing-function: var(--ease-in-out);
    }

    ::view-transition-old(filter-indicator),
    ::view-transition-new(filter-indicator) {
      width: 100%;
      height: 100%;
    }
  }
</style>
