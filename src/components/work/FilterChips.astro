---
// Discipline filters as plain links to pre-rendered pages: shareable, no
// JavaScript, and the current one is marked with aria-current. Each chip and
// the current chip's pill carry view-transition names, so moving between the
// filtered pages slides the pill from one chip to the next.
export type WorkFilter = 'all' | 'graphic-design' | 'uiux' | 'photography';

interface Props {
  current: WorkFilter;
  counts: Partial<Record<WorkFilter, number>>;
  labels: { graphicDesign: string; uiux: string; photography: string };
}
const { current, counts, labels } = Astro.props;
const chips: { key: WorkFilter; label: string; href: string }[] = [
  { key: 'all', label: 'All', href: '/projects/' },
  { key: 'graphic-design', label: labels.graphicDesign, href: '/projects/graphic-design/' },
  { key: 'uiux', label: labels.uiux, href: '/projects/uiux/' },
  { key: 'photography', label: labels.photography, href: '/photography/' },
];
---
<nav class="filter-chips" aria-label="Filter work">
  <ul class="cluster" role="list">
    {
      chips.map((chip) => (
        <li>
          <a class="chip" href={chip.href} aria-current={chip.key === current ? 'page' : undefined} style={`--vt-chip: chip-${chip.key}`}>
            {chip.key === current && <span class="chip__indicator" aria-hidden="true" />}
            {chip.label}
            {counts[chip.key] !== undefined && <span class="chip__count">{counts[chip.key]}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .filter-chips ul {
    margin: 0;
    --cluster-gap: var(--space-2xs);
  }

  /* The current chip's fill is its own element (the pill), so it can travel. */
  .filter-chips .chip {
    position: relative;
    overflow: clip;
    isolation: isolate;
  }

  .filter-chips .chip[aria-current] {
    background: transparent;
  }

  .chip__indicator {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--espresso);
  }

  @media (prefers-reduced-motion: no-preference) {
    .filter-chips .chip {
      view-transition-name: var(--vt-chip);
      view-transition-class: chip;
    }

    .chip__indicator {
      view-transition-name: filter-indicator;
    }
  }

  @media (forced-colors: active) {
    .chip__indicator {
      forced-color-adjust: none;
      background: Highlight;
    }

    .filter-chips .chip[aria-current] {
      forced-color-adjust: none;
      color: HighlightText;
    }
  }
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    /* Labels ride above the sliding pill; the pill is clipped round at every width. */
    ::view-transition-group(*.chip) {
      z-index: var(--z-raised);
    }

    /* The pill travels from one chip to the next. */
    ::view-transition-group(filter-indicator) {
      overflow: clip;
      border-radius: var(--radius-pill);
      animation-duration: var(--duration-slow);
      animation-timing-function: var(--ease-in-out);
    }

    ::view-transition-old(filter-indicator),
    ::view-transition-new(filter-indicator) {
      width: 100%;
      height: 100%;
    }
  }
</style>
