---
import type { Project } from '../../lib/content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
  /** `grid`: the Work index, an editorial rhythm of wide and narrow cards.
      `trio`: three across on wide screens (short suggestion lists). */
  layout?: 'grid' | 'trio';
  headingLevel?: 2 | 3;
  /** Load the first card's image eagerly (it is above the fold). */
  priorityFirst?: boolean;
}
const { projects, layout = 'grid', headingLevel = 2, priorityFirst = false } = Astro.props;
// Cards pair up; a card that would sit alone on the last row spans it instead
// of leaving a hole.
const isLone = (i: number) => i === projects.length - 1 && i % 2 === 0;
// From 64em the grid alternates 7/5 and 5/7 rows (see the CSS): the narrow slots.
const narrow = (i: number) => layout === 'grid' && !isLone(i) && (i % 4 === 1 || i % 4 === 2);
const sizesFor = (i: number) =>
  layout === 'trio'
    ? '(min-width: 64em) 24rem, (min-width: 36em) 50vw, 100vw'
    : narrow(i)
      ? '(min-width: 64em) 31rem, (min-width: 36em) 50vw, 100vw'
      : '(min-width: 64em) 44rem, (min-width: 36em) 50vw, 100vw';
---
<ul class:list={['work-grid', `work-grid--${layout}`]} role="list">
  {
    projects.map((project, i) => (
      <li class:list={{ 'work-grid__lone': isLone(i) }} data-reveal style={{ '--reveal-index': i % 2 }}>
        <ProjectCard
          project={project}
          headingLevel={headingLevel}
          priority={priorityFirst && i === 0}
          sizes={sizesFor(i)}
        />
      </li>
    ))
  }
</ul>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl) var(--space-l);
    margin: 0;
  }

  @media (min-width: 36em) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work-grid__lone {
      grid-column: 1 / -1;
    }

    .work-grid__lone :global(.project-card) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: var(--space-l);
    }
  }

  @media (min-width: 64em) {
    .work-grid {
      gap: var(--space-2xl) var(--space-xl);
    }

    /* The Work index: rows of 7/5 then 5/7 columns, the right-hand card set
       lower, so the eye zigzags down the page like through a magazine. */
    .work-grid--grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .work-grid--grid > li:not(.work-grid__lone) {
      grid-column: span 7;
    }

    .work-grid--grid > li:is(:nth-child(4n + 2), :nth-child(4n + 3)):not(.work-grid__lone) {
      grid-column: span 5;
    }

    .work-grid--grid > li:nth-child(even):not(.work-grid__lone) {
      margin-block-start: var(--space-3xl);
    }

    /* Logos stand taller in the narrow slots; a lone last card spans the row
       (its own 7/5 split), so it keeps the standard panel. */
    .work-grid--grid > li:is(:nth-child(4n + 2), :nth-child(4n + 3)):not(.work-grid__lone) :global(.project-card__media[data-fit='contain']) {
      --ratio: 4 / 5;
    }

    .work-grid--trio {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-xl) var(--space-l);
    }

    /* Three across, a trio leaves no card alone: back to the standard card. */
    .work-grid--trio .work-grid__lone {
      grid-column: auto;
    }

    .work-grid--trio .work-grid__lone :global(.project-card) {
      grid-template-columns: none;
      align-items: normal;
      gap: var(--space-s);
    }
  }
</style>
