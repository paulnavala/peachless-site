---
// The Work index and its pre-filtered views (a discipline, a tool) share this template.
import Base from '../../layouts/Base.astro';
import PageBody from '../sections/PageBody.astro';
import WorkHeader from '../sections/WorkHeader.astro';
import WorkList from '../sections/WorkList.astro';
import WorkLogos from '../sections/WorkLogos.astro';
import type { Discipline, Tool } from '../../lib/content-schema';
import { loadPage } from '../../lib/pages';

interface Props {
  discipline?: Discipline;
  /** A "Made with" view: the projects made with this tool. */
  tool?: Tool;
  /** For alias URLs (/projects/logo-design/): point search engines at the real page. */
  canonical?: string;
}
const { head, plan } = await loadPage('work', Astro.props);
---
<Base {...head}>
  <PageBody plan={plan} bound={{ 'work-header': WorkHeader, 'work-list': WorkList, 'work-logos': WorkLogos }} />
</Base>
