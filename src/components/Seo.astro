---
interface Props {
  title?: string; // page name without suffix; empty = home
  description: string;
  /** Absolute or root-relative share image; defaults to the site image. */
  image?: string;
  canonical?: string;
  noindex?: boolean;
}
const { title = '', description, image, canonical: canonicalPath, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — peachless.` : 'peachless.';
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og/peachless.jpg', Astro.site);
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:site_name" content="peachless." />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{!image && <meta property="og:image:width" content="1000" />}
{!image && <meta property="og:image:height" content="500" />}
<meta name="twitter:card" content="summary_large_image" />
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'peachless.',
    url: Astro.site?.toString(),
    description,
  }).replace(/</g, '\\u003c')}
/>
