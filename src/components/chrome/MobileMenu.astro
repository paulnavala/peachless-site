---
import { getEntry } from 'astro:content';
import { navCurrent } from '../../lib/nav';
import PeachMark from '../ui/PeachMark.astro';
import Wordmark from '../ui/Wordmark.astro';
import Icon from '../ui/Icon.astro';

const site = await getEntry('site', 'site');
const { nav, emails, tagline, siteName } = site!.data;
const links = nav.filter((item) => !item.cta);
const cta = nav.find((item) => item.cta);
const path = Astro.url.pathname;
---
<dialog class="mobile-menu" id="mobile-menu" aria-label="Menu" data-mobile-menu>
  <div class="mobile-menu__inner container">
    <div class="mobile-menu__top">
      <a class="mobile-menu__brand" href="/">
        <PeachMark class="mobile-menu__mark" />
        <Wordmark name={siteName} />
      </a>
      <button class="btn btn--secondary btn--sm" type="button" data-menu-close>
        Close
        <Icon name="close" />
      </button>
    </div>

    <nav class="mobile-menu__nav" aria-label="Mobile">
      <ol class="mobile-menu__list" role="list">
        {links.map((item, i) => (
          <li style={`--i: ${i}`}>
            <a
              class="mobile-menu__link"
              href={item.href}
              aria-current={navCurrent(item.href, path)}
              autofocus={i === 0}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ol>
      {cta && (
        <a
          class="btn btn--accent btn--lg mobile-menu__cta"
          href={cta.href}
          aria-current={navCurrent(cta.href, path)}
          style={`--i: ${links.length}`}
        >
          {cta.label}
        </a>
      )}
    </nav>

    <div class="mobile-menu__foot" style={`--i: ${links.length + 1}`}>
      <ul class="mobile-menu__emails" role="list">
        {emails.map((e) => (
          <li><a class="link-quiet" href={`mailto:${e.address}`}>{e.address}</a></li>
        ))}
      </ul>
      <p class="mobile-menu__tagline">{tagline}</p>
    </div>
  </div>
</dialog>

<script>
  import { lockScroll, trapFocus } from '../../lib/dom';
  import { minWidth } from '../../lib/breakpoints';

  const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (dialog && openBtn) {
    let releaseTrap: (() => void) | null = null;
    let unlockScroll: (() => void) | null = null;

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
      releaseTrap = trapFocus(dialog, 'a[href], button');
      unlockScroll = lockScroll();
    };
    const close = () => {
      if (dialog.open) dialog.close();
    };

    // One exit path: Escape (cancel), the Close button and link clicks all end
    // in the dialog's close event.
    dialog.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      releaseTrap?.();
      unlockScroll?.();
      releaseTrap = unlockScroll = null;
      openBtn.focus({ preventScroll: true });
    });
    openBtn.addEventListener('click', open);
    dialog.querySelector('[data-menu-close]')?.addEventListener('click', close);
    dialog.querySelectorAll('a[href]').forEach((a) => a.addEventListener('click', close));
    matchMedia(minWidth('md')).addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>

<style>
  .mobile-menu {
    width: 100%;
    height: 100%;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .mobile-menu::backdrop {
    background: var(--color-bg);
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    min-height: 100%;
    padding-block: var(--space-s) var(--space-l);
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h-condensed);
  }

  .mobile-menu__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-2);
    color: var(--color-heading);
    text-decoration: none;
  }

  .mobile-menu__brand :global(.peach-mark) {
    width: 1.55rem;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .mobile-menu__list {
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: var(--weight-display);
    line-height: 1.1;
    text-decoration: none;
  }

  .mobile-menu__link:is(:hover, :focus-visible),
  .mobile-menu__link[aria-current] {
    color: var(--color-accent-text);
  }

  .mobile-menu__cta {
    align-self: stretch;
  }

  .mobile-menu__foot {
    margin-top: auto;
    display: grid;
    gap: var(--space-xs);
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }

  .mobile-menu__emails {
    display: grid;
    gap: var(--space-3xs);
    margin: 0;
  }

  .mobile-menu__tagline {
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The menu draws down like a blind and lifts away when it closes (its
       opaque backdrop with it); links, the call to action and the foot follow
       in a short stagger. */
    .mobile-menu,
    .mobile-menu::backdrop {
      opacity: 1;
      clip-path: inset(0 0 100% 0);
      transition:
        clip-path var(--duration-base) var(--ease-in),
        display var(--duration-base) allow-discrete,
        overlay var(--duration-base) allow-discrete;
    }

    .mobile-menu[open],
    .mobile-menu[open]::backdrop {
      clip-path: inset(0);
      transition-duration: var(--duration-slow);
      transition-timing-function: var(--ease-out);
    }

    @starting-style {
      .mobile-menu[open],
      .mobile-menu[open]::backdrop {
        clip-path: inset(0 0 100% 0);
      }
    }

    .mobile-menu__link {
      transition: color var(--duration-fast) var(--ease-standard);
    }

    .mobile-menu[open] :is(.mobile-menu__list li, .mobile-menu__cta, .mobile-menu__foot) {
      animation: menu-in var(--duration-slow) var(--ease-out) both;
      animation-delay: calc(var(--duration-instant) + var(--i) * var(--stagger));
    }

    @keyframes menu-in {
      from {
        opacity: 0;
        translate: 0 0.75rem;
      }
    }
  }
</style>
