---
// A playful closer for the contact page: crack the peach for a fortune and six
// lucky numbers. Fortunes come from the CMS (Contact page → Fortune peach).
import PeachMark from '../ui/PeachMark.astro';

interface Props {
  heading: string;
  intro?: string;
  fortunes: string[];
}
const { heading, intro, fortunes } = Astro.props;
---
<section class="fortune" aria-labelledby="fortune-title" data-fortunes={JSON.stringify(fortunes)}>
  <div class="fortune__head">
    <h2 id="fortune-title" class="fortune__title">{heading}</h2>
    {intro && <p class="fortune__intro">{intro}</p>}
  </div>

  <div class="flw-stage flw-stage--unopened" id="flwStage">
    <button class="fortune__peach" id="flwLogoBtn" type="button">
      <span class="fortune__mark">
        <PeachMark />
      </span>
      <span class="fortune__cta">Crack open a fortune</span>
    </button>

    <div class="fortune__cracking" id="flwCracking" hidden aria-hidden="true">
      <span class="fortune__half fortune__half--left"><PeachMark /></span>
      <span class="fortune__half fortune__half--right"><PeachMark /></span>
      <span class="fortune__sparks" id="flwParticles"></span>
    </div>

    <div class="fortune__card" id="flwRevealed" hidden aria-hidden="true" data-surface="inverse">
      <p class="eyebrow">Your fortune</p>
      <p class="fortune__quote t-quote" id="flwQuote"></p>
      <p class="fortune__lucky-label">Lucky numbers</p>
      <p class="fortune__balls" id="flwBalls"></p>
      <button class="btn btn--accent" type="button" id="flwAgain">Try again</button>
    </div>
  </div>

  <!-- Announces the result. Live regions inside hidden content aren't read, so
       this one stays outside the card. -->
  <p class="sr-only" role="status" id="flwAnnounce"></p>
</section>

<script>
  import { isPointerClick, isReducedMotion } from '../../lib/dom';

  const root = document.querySelector<HTMLElement>('[data-fortunes]');
  const stage = document.getElementById('flwStage');
  const logoBtn = document.getElementById('flwLogoBtn');
  const cracking = document.getElementById('flwCracking');
  const revealed = document.getElementById('flwRevealed');
  const again = document.getElementById('flwAgain');
  const quoteEl = document.getElementById('flwQuote');
  const ballsEl = document.getElementById('flwBalls');
  const sparks = document.getElementById('flwParticles');
  const announcer = document.getElementById('flwAnnounce');

  if (root && stage && logoBtn && cracking && revealed && again && quoteEl && ballsEl && sparks && announcer) {
    const fortunes: string[] = JSON.parse(root.dataset.fortunes ?? '[]');
    const CRACK_MS = 1200;

    const pick = () => {
      const quote = fortunes[Math.floor(Math.random() * fortunes.length)] ?? '';
      const nums = new Set<number>();
      while (nums.size < 6) nums.add(1 + Math.floor(Math.random() * 70));
      return { quote, lucky: [...nums].sort((a, b) => a - b) };
    };

    const setStage = (name: 'unopened' | 'cracking' | 'revealed') => {
      stage.className = `flw-stage flw-stage--${name}`;
      cracking.hidden = name !== 'cracking';
      revealed.hidden = name !== 'revealed';
      cracking.setAttribute('aria-hidden', String(name !== 'cracking'));
      revealed.setAttribute('aria-hidden', String(name !== 'revealed'));
    };

    const spawnSparks = () => {
      sparks.replaceChildren();
      if (isReducedMotion()) return;
      for (let i = 0; i < 16; i++) {
        const s = document.createElement('span');
        const angle = (i / 16) * Math.PI * 2;
        const dist = 70 + Math.random() * 60;
        s.style.setProperty('--dx', `${Math.cos(angle) * dist}px`);
        s.style.setProperty('--dy', `${Math.sin(angle) * dist}px`);
        s.style.setProperty('--delay', `${200 + Math.random() * 250}ms`);
        sparks.append(s);
      }
    };

    // moveFocus (keyboard and screen-reader use): the control that was used is
    // about to be hidden, so move focus on instead of letting it fall to <body>.
    const crack = (moveFocus: boolean) => {
      const result = pick();
      announcer.textContent = '';
      // From now on the peach comes back with an entrance after "Try again".
      stage.dataset.played = '';
      setStage('cracking');
      spawnSparks();
      setTimeout(
        () => {
          quoteEl.textContent = `“${result.quote}”`;
          ballsEl.replaceChildren(
            ...result.lucky.map((n, i) => {
              const ball = document.createElement('span');
              ball.className = 'fortune__ball';
              ball.style.setProperty('--i', String(i));
              ball.textContent = String(n);
              return ball;
            })
          );
          setStage('revealed');
          announcer.textContent = `Your fortune: ${result.quote} Your lucky numbers: ${result.lucky.join(', ')}.`;
          if (moveFocus) again.focus();
        },
        isReducedMotion() ? 0 : CRACK_MS
      );
    };

    const reset = (moveFocus: boolean) => {
      setStage('unopened');
      announcer.textContent = '';
      if (moveFocus) logoBtn.focus();
    };

    logoBtn.addEventListener('click', (e) => crack(!isPointerClick(e)));
    again.addEventListener('click', (e) => reset(!isPointerClick(e)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && stage.classList.contains('flw-stage--revealed')) {
        e.preventDefault();
        reset(stage.contains(document.activeElement));
      }
    });
  }
</script>

<style>
  .fortune {
    display: grid;
    justify-items: center;
    gap: var(--space-l);
    text-align: center;
  }

  .fortune__head {
    display: grid;
    gap: var(--space-2xs);
  }

  .fortune__title {
    font-size: var(--text-h2);
  }

  .fortune__intro {
    color: var(--color-text-secondary);
  }

  .flw-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 22rem;
    width: 100%;
  }

  .flw-stage > * {
    grid-area: 1 / 1;
  }

  .flw-stage--cracking .fortune__peach,
  .flw-stage--revealed .fortune__peach {
    visibility: hidden;
  }

  /* ── Unopened ─────────────────────────────────────────────────────────── */
  .fortune__peach {
    display: grid;
    justify-items: center;
    gap: var(--space-s);
    padding: var(--space-s) var(--space-m);
    border-radius: var(--radius-xl);
  }

  .fortune__mark {
    display: block;
    width: 7.5rem;
    filter: drop-shadow(0 14px 18px rgb(var(--espresso-rgb) / 0.18));
  }

  .fortune__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.6em 1.4em;
    border-radius: var(--radius-pill);
    background: var(--clay);
    color: var(--espresso);
    font-size: var(--text-ui);
    font-weight: var(--weight-medium);
  }

  .fortune__peach:is(:hover, :focus-visible) .fortune__cta {
    background: var(--clay-deep);
  }

  /* ── Cracking ─────────────────────────────────────────────────────────── */
  .fortune__cracking {
    position: relative;
    width: 7.5rem;
    aspect-ratio: 312.94 / 435.1;
  }

  .fortune__half {
    position: absolute;
    inset: 0;
  }

  .fortune__half--left {
    clip-path: inset(0 50% 0 0);
  }

  .fortune__half--right {
    clip-path: inset(0 0 0 50%);
  }

  .fortune__sparks {
    position: absolute;
    inset: 50% auto auto 50%;
  }

  .fortune__sparks :global(span) {
    position: absolute;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--clay);
  }

  /* ── Revealed ─────────────────────────────────────────────────────────── */
  .fortune__card {
    display: grid;
    justify-items: center;
    gap: var(--space-s);
    width: min(100%, 34rem);
    padding: var(--space-l) var(--space-m);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .fortune__quote {
    color: var(--color-heading);
  }

  .fortune__lucky-label {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  .fortune__balls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
  }

  .fortune__balls :global(.fortune__ball) {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    background: var(--clay);
    color: var(--espresso);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }

  /* Motion: base styles above are the final state; animation only adds the
     journey there, and only for visitors who allow motion. */
  @media (prefers-reduced-motion: no-preference) {
    .fortune__mark {
      animation: fortune-float 3.2s var(--ease-in-out) infinite alternate;
    }

    .fortune__peach:hover .fortune__mark {
      animation-play-state: paused;
    }

    .fortune__cta {
      transition: background-color var(--duration-fast) var(--ease-standard);
    }

    /* "Try again": a fresh peach settles back into place. */
    :global(.flw-stage--unopened[data-played]) .fortune__peach {
      animation: fortune-back var(--duration-slow) var(--ease-out) both;
    }

    .fortune__half--left {
      animation: fortune-left 900ms var(--ease-out) 250ms both;
    }

    .fortune__half--right {
      animation: fortune-right 900ms var(--ease-out) 250ms both;
    }

    .fortune__sparks :global(span) {
      animation: fortune-spark 700ms var(--ease-out) var(--delay) both;
    }

    .fortune__card {
      animation: fortune-card 500ms var(--ease-out) both;
    }

    .fortune__balls :global(.fortune__ball) {
      animation: fortune-ball 420ms var(--ease-out) both;
      animation-delay: calc(200ms + var(--i) * 80ms);
    }

    @keyframes fortune-float {
      from {
        translate: 0 0.35rem;
      }
    }

    @keyframes fortune-left {
      to {
        translate: -1.5rem 0.5rem;
        rotate: -14deg;
        opacity: 0;
      }
    }

    @keyframes fortune-right {
      to {
        translate: 1.5rem 0.5rem;
        rotate: 14deg;
        opacity: 0;
      }
    }

    @keyframes fortune-spark {
      from {
        translate: 0 0;
        opacity: 1;
      }

      to {
        translate: var(--dx) var(--dy);
        opacity: 0;
      }
    }

    @keyframes fortune-card {
      from {
        opacity: 0;
        translate: 0 1rem;
        scale: 0.98;
      }
    }

    @keyframes fortune-ball {
      from {
        opacity: 0;
        scale: 0.6;
      }
    }

    @keyframes fortune-back {
      from {
        opacity: 0;
        scale: 0.9;
      }
    }
  }
</style>
