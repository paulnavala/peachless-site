---
import { Font } from 'astro:assets';
import Seo from '../components/Seo.astro';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import type { JsonLdNode } from '../lib/structured-data';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components/cursor-label.css';

interface Props {
  title?: string;
  description: string;
  /** Absolute or root-relative share image; defaults to the site image. */
  ogImage?: string;
  /** Override the canonical URL (alias pages point at the real one). */
  canonical?: string;
  noindex?: boolean;
  /** Which Cormorant face the page's h1 uses; preloaded to avoid a swap. */
  preloadSerif?: 'normal' | 'italic';
  /** Show the "Let's create together" invitation in the footer. */
  footerCta?: boolean;
  /** schema.org nodes for search engines (src/lib/structured-data.ts). */
  jsonLd?: JsonLdNode[];
}
const { title, description, ogImage, canonical, noindex = false, preloadSerif = 'normal', footerCta = true, jsonLd } = Astro.props;

// Prefetch same-site pages on hover/press (Chromium); the admin is excluded.
const speculationRules = JSON.stringify({
  prefetch: [
    {
      source: 'document',
      where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/admin/*' } }] },
      eagerness: 'moderate',
    },
  ],
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#efe1d4" /><!-- style-guard-ignore: mirrors --linen -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <Seo title={title} description={description} image={ogImage} canonical={canonical} noindex={noindex} jsonLd={jsonLd} />
    <Font cssVariable="--font-inter" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-cormorant" preload={[{ style: preloadSerif }]} />
    {/* Romanian letters, fetched only by pages that use them (astro.config.mjs). */}
    <Font cssVariable="--font-inter-ro" />
    <Font cssVariable="--font-cormorant-ro" />
    {/* Lazy images fade in as they arrive (motion.css): mark each one once it
        has loaded, or failed (so its alt text shows). Inline in <head>, so it
        is listening before any image loads; `load` doesn't bubble, so catch it
        on the way down. (Comments stay out of inline scripts: they ship.) */}
    <script is:inline>
      document.documentElement.classList.add('img-fade');
      for (const t of ['load', 'error'])
        document.addEventListener(t, (e) => { if (e.target instanceof HTMLImageElement) e.target.dataset.loaded = ''; }, true);
    </script>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline type="speculationrules" set:html={speculationRules} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer showCta={footerCta} />
    <script>
      import { initReveal } from '../lib/reveal';
      import { initCursorLabel } from '../lib/cursor-label';
      initReveal();
      initCursorLabel();
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
