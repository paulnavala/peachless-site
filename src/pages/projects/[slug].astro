---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectHero from '../../components/project/ProjectHero.astro';
import NextProject from '../../components/project/NextProject.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import CtaBand from '../../components/CtaBand.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import { getPublishedProjects, getSingleton } from '../../lib/content';
import { nextProject } from '../../lib/project-order';
import { projectTheme } from '../../lib/project-theme';
import { storyChapters, TOC_MIN_CHAPTERS } from '../../lib/chapters';
import { projectLd } from '../../lib/structured-data';

export async function getStaticPaths() {
  // Published projects only: a hidden project gets no page at all.
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, next: nextProject(projects, project.id) },
  }));
}

const { project, next } = Astro.props;
const { title, summary, seo, cover, accent, blocks } = project.data;
const chapters = storyChapters(blocks);

// Share image: an explicit one, else a photographic cover cropped to 1200×630;
// logo covers fall back to the site image (a cropped transparent logo reads badly).
const shareSource = seo?.image || (cover.fit === 'cover' && cover.image.format !== 'svg' ? cover.image : undefined);
const share = shareSource ? await getImage({ src: shareSource, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : undefined;
const site = (await getSingleton('site')).data;
---
<Base
  title={seo?.title || title}
  description={seo?.description || summary}
  ogImage={share?.src}
  jsonLd={projectLd(project, site, Astro.site!, share?.src)}
>
  <article class="project" style={projectTheme(accent)}>
    <div class="project__progress" aria-hidden="true"></div>
    <ProjectHero project={project} chapters={chapters.length >= TOC_MIN_CHAPTERS ? chapters : []} />
    <BlockRenderer blocks={blocks} chapters={chapters} projectTitle={title} cover={cover} />
  </article>
  {
    next ? (
      <NextProject project={next} />
    ) : (
      <CtaBand eyebrow="Keep exploring" heading="See more of the work." tone="paper">
        <ArrowLink href="/projects/">All work</ArrowLink>
      </CtaBand>
    )
  }
</Base>

<style>
  /* Reading progress: a line under the sticky header that fills as the story
     scrolls by (the article's own timeline, so it ends with the story, not
     the footer). Decoration: off without scroll timelines or under reduced
     motion. Keep overflow: hidden off every ancestor, or it stops sticking. */
  .project__progress {
    display: none;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .project {
        view-timeline-name: --story;
        view-timeline-axis: block;
        view-timeline-inset: 0px;
      }

      .project__progress {
        position: sticky;
        top: var(--header-h-condensed);
        z-index: var(--z-sticky);
        display: block;
        block-size: 2px;
        margin-block-end: -2px;
        background: var(--project-ink, var(--color-accent-text));
        transform-origin: 0 50%;
        animation: story-progress linear both;
        animation-timeline: --story;
        animation-range: contain 0% contain 100%;
      }

      @keyframes story-progress {
        from {
          transform: scaleX(0);
        }
      }
    }
  }
</style>
