---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/islands/ContactForm.vue';
import FortunePeach from '../components/static/FortunePeach.astro';
import CtaBand from '../components/CtaBand.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import Icon from '../components/ui/Icon.astro';
import { getSingleton } from '../lib/content';

const contact = (await getSingleton('contact')).data;
const { emails, socials } = (await getSingleton('site')).data;
// Long addresses may wrap; offer the break before the @ ("name / @domain").
const splitAt = (address: string) => [address.slice(0, address.indexOf('@')), address.slice(address.indexOf('@'))];
const form = (await getSingleton('form')).data;
---
<Base title="Contact" description={contact.seo.description ?? contact.lede ?? contact.heading} footerCta={false}>
  <section class="section contact">
    <div class="container contact__inner">
      <div class="contact__intro">
        {contact.eyebrow && <p class="eyebrow eyebrow--rule">{contact.eyebrow}</p>}
        <h1 class="contact__title">{contact.heading}</h1>
        {contact.lede && <p class="lede">{contact.lede}</p>}
        <ul class="contact-emails" role="list">
          {
            emails.map((e) => (
              <li>
                <span class="contact-emails__label">{e.label}</span>
                <a class="contact-emails__link" href={`mailto:${e.address}`}>
                  <span>{splitAt(e.address)[0]}<wbr />{splitAt(e.address)[1]}</span>
                  <Icon name="arrow-up-right" />
                </a>
              </li>
            ))
          }
        </ul>
        {
          socials.length > 0 && (
            <ul class="cluster contact__socials" role="list">
              {socials.map((s) => (
                <li>
                  <a class="chip" href={s.url} rel="me noopener" target="_blank">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div class="contact__card">
        <ContactForm
          client:visible
          title={contact.form.title}
          subtitle={contact.form.subtitle}
          submitText={contact.form.submitLabel}
          successMessage={contact.form.successMessage}
          formAction={form.endpoint}
          hiddenFields={form.hidden}
          contactEmail={emails[0]?.address}
        />
      </div>
    </div>
  </section>

  <section class="section" data-surface="blush">
    <div class="container">
      <FortunePeach heading={contact.fortune.heading} intro={contact.fortune.intro} fortunes={contact.fortune.fortunes} />
    </div>
  </section>

  <CtaBand eyebrow="Before you go" heading="Or browse the work first." tone="paper">
    <ArrowLink href="/projects/">See the work</ArrowLink>
    <ArrowLink href="/photography/">Photography</ArrowLink>
  </CtaBand>
</Base>

<style>
  .contact__inner {
    display: grid;
    gap: var(--space-xl);
  }

  .contact__intro {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .contact__title {
    font-size: var(--text-h1);
    max-width: 12ch;
  }

  .contact-emails {
    container-type: inline-size;
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-xs);
  }

  .contact-emails li {
    display: grid;
    gap: var(--space-3xs);
  }

  .contact-emails__label {
    font-size: var(--text-micro);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .contact-emails__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    width: fit-content;
    font-family: var(--font-display);
    /* A typical address plus the arrow is ~12.5em: shrink to fit narrow columns. */
    font-size: min(var(--step-3), 7.5cqi);
    font-weight: var(--weight-display);
    color: var(--color-heading);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact-emails__link:hover {
    color: var(--color-accent-text);
  }

  .contact-emails__link :global(svg) {
    width: 0.7em;
    height: 0.7em;
    flex: none;
  }

  .contact__socials {
    margin: 0;
  }

  .contact__card {
    padding: var(--space-m-xl);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 64em) {
    .contact__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
    }
  }
</style>
