---
import Base from '../layouts/Base.astro';
import PageBody from '../components/sections/PageBody.astro';
import Contact from '../components/sections/Contact.astro';
import Fortune from '../components/sections/Fortune.astro';
import { loadPage } from '../lib/pages';

const { head, plan } = await loadPage('contact');
---
<Base {...head}>
  <PageBody plan={plan} bound={{ contact: Contact, fortune: Fortune }} />
</Base>
