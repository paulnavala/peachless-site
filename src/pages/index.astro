---
// Home tells the story in one scroll, in the order its page document gives:
// who (with a reel of the work) → what I believe → selected stories → what I do
// → through my lens → hello → (footer) let's create together.
import Base from '../layouts/Base.astro';
import PageBody from '../components/sections/PageBody.astro';
import Hero from '../components/sections/Hero.astro';
import { loadPage } from '../lib/pages';

const { head, plan } = await loadPage('home');
---
<Base {...head}>
  <PageBody plan={plan} bound={{ hero: Hero }} />
</Base>
