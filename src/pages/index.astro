---
// Home tells the story in one scroll: who (with a reel of the work) → what I
// believe → what I do → selected stories → through my lens → hello →
// (footer) let's create together.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HomeHero from '../components/home/HomeHero.astro';
import type { ReelTile } from '../components/home/WorkReel.astro';
import DisciplineIndex, { type DisciplineEntry } from '../components/home/DisciplineIndex.astro';
import StoryDeck from '../components/home/StoryDeck.astro';
import PhotoStrip from '../components/home/PhotoStrip.astro';
import AboutTeaser from '../components/home/AboutTeaser.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import LitStatement from '../components/ui/LitStatement.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import { getFeaturedPhotos, getFeaturedProjects, getPublishedPhotos, getPublishedProjects, getSingleton } from '../lib/content';
import { reelPicks } from '../lib/project-order';
import { projectTheme } from '../lib/project-theme';
import { renderInline } from '../lib/markdown';
import { personLd, websiteLd } from '../lib/structured-data';

const home = (await getSingleton('home')).data;
const work = (await getSingleton('work')).data;
const about = (await getSingleton('about')).data;
const portrait = await getImage({ src: about.portrait, width: 800, format: 'jpg' });
const site = (await getSingleton('site')).data;
const projects = await getPublishedProjects();
const featured = await getFeaturedProjects();
const photos = await getPublishedPhotos();
const strip = (await getFeaturedPhotos(5)).slice(0, 5);

// The hero reel: work the rest of the page doesn't show yet.
const deckIds = new Set(featured.map((p) => p.id));
const photoRatio = (w: number, h: number) => (w / h < 0.9 ? '4 / 5' : w / h <= 1.15 ? '1 / 1' : w / h < 1.45 ? '4 / 3' : '3 / 2');
const reel: ReelTile[] = reelPicks(projects, featured, photos, strip).map((pick) => {
  if (pick.kind === 'photo') {
    const { image, title } = pick.entry.data;
    return { href: '/photography/', label: title, image, fit: 'cover', panel: 'none', ratio: photoRatio(image.width, image.height) };
  }
  const { cover, title, accent } = pick.entry.data;
  const ratio = cover.fit === 'cover' ? '4 / 3' : cover.image.width / cover.image.height > 1.2 ? '1 / 1' : '4 / 5';
  return {
    href: `/projects/${pick.entry.id}/`,
    label: title,
    image: cover.image,
    fit: cover.fit,
    panel: cover.panel,
    ratio,
    vt: deckIds.has(pick.entry.id) ? undefined : `work-${pick.entry.id}`,
    theme: projectTheme(accent),
  };
});

const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const firstOf = (discipline: 'graphic-design' | 'uiux') => {
  const list = projects.filter((p) => p.data.disciplines.includes(discipline));
  // Prefer a photographic cover for variety; fall back to the first project.
  const pick = list.find((p) => p.data.cover.fit === 'cover') ?? list[0];
  return { list, pick };
};
const graphic = firstOf('graphic-design');
const uiux = firstOf('uiux');
const preview = (project?: (typeof projects)[number]) =>
  project && {
    image: { image: project.data.cover.image, panel: project.data.cover.panel, fit: project.data.cover.fit },
    theme: projectTheme(project.data.accent),
  };
const disciplines: DisciplineEntry[] = [
  {
    ...work.disciplines.graphicDesign,
    href: '/projects/graphic-design/',
    count: plural(graphic.list.length, 'project'),
    ...preview(graphic.list[0]),
  },
  {
    ...work.disciplines.uiux,
    href: '/projects/uiux/',
    count: plural(uiux.list.length, 'project'),
    ...preview(uiux.pick),
  },
  {
    ...work.disciplines.photography,
    href: '/photography/',
    count: plural(photos.length, 'photo'),
    image: photos[0] && { image: photos[0].data.image, panel: 'none', fit: 'cover' },
  },
];
---
<Base
  description={home.seo.description ?? site.seo.description}
  preloadSerif="italic"
  jsonLd={[websiteLd(site, Astro.site!), personLd(site, Astro.site!, portrait.src)]}
>
  <HomeHero
    eyebrow={home.eyebrow}
    line1={home.tagline.line1}
    line2={home.tagline.line2}
    lede={home.lede}
    primary={home.primaryCta}
    secondary={home.secondaryCta}
    reel={reel}
  />

  <section class="section manifesto sheet" data-surface="paper" aria-labelledby="manifesto-title">
    <div class="container manifesto__inner">
      <LitStatement id="manifesto-title" class="manifesto__title" text={home.manifesto.heading} />
      <div class="manifesto__aside" data-reveal style="--reveal-index: 1">
        <p class="manifesto__lead" set:html={renderInline(home.manifesto.lead)} />
        <ArrowLink href="/about/">{home.about.linkLabel}</ArrowLink>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <SectionHeader id="services-title" title={home.services.heading} lede={home.services.intro} />
      <DisciplineIndex entries={disciplines} />
    </div>
  </section>

  <section class="section selected-work" aria-labelledby="featured-title">
    <div class="container">
      <SectionHeader
        id="featured-title"
        title={home.featured.heading}
        lede={home.featured.intro}
        action={{ href: '/projects/', label: 'All work' }}
      />
      <StoryDeck projects={featured} />
    </div>
  </section>

  {
    strip.length > 0 && (
      <section class="section sheet" data-surface="blush" aria-labelledby="photography-title">
        <div class="container">
          <SectionHeader
            id="photography-title"
            title={home.photography.heading}
            lede={home.photography.intro}
            action={{ href: '/photography/', label: 'View the gallery' }}
          />
          <PhotoStrip photos={strip} />
        </div>
      </section>
    )
  }

  <AboutTeaser
    heading={home.about.heading}
    body={home.about.body}
    linkLabel={home.about.linkLabel}
    portrait={about.portrait}
    portraitAlt={about.portraitAlt}
  />
</Base>

<style>
  .manifesto__inner {
    display: grid;
    gap: var(--space-l);
  }

  .manifesto__title {
    max-width: 15ch;
    font-size: var(--text-statement);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .manifesto__aside {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    align-content: end;
  }

  .manifesto__lead {
    font-size: var(--step-1);
    color: var(--color-text-secondary);
    max-width: 38ch;
  }

  @media (min-width: 64em) {
    .manifesto__inner {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: var(--space-2xl);
      align-items: end;
    }
  }

  .selected-work {
    padding-block-start: 0;
  }
</style>
