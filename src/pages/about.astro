---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Media from '../components/ui/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import { getSingleton } from '../lib/content';

const about = await getSingleton('about');
const { Content } = await render(about);
const { eyebrow, title, statement, portrait, portraitAlt, closing, seo } = about.data;
---
<Base title="About" description={seo.description ?? statement}>
  <section class="section about">
    <div class="container about__inner">
      <div class="about__portrait">
        <Media image={portrait} alt={portraitAlt} sizes="(min-width: 64em) 30rem, 90vw" priority />
      </div>
      <div class="about__text">
        {eyebrow && <p class="eyebrow eyebrow--rule">{eyebrow}</p>}
        <h1 class="about__title">{title}</h1>
        <p class="about__statement t-quote">{statement}</p>
        <div class="about__body flow">
          <Content />
        </div>
        {closing && <p class="about__closing kicker">{closing}</p>}
      </div>
    </div>
  </section>

  <CtaBand eyebrow="Keep exploring" heading="See the work behind the words." tone="paper">
    <ArrowLink href="/projects/">Explore my work</ArrowLink>
    <ArrowLink href="/photography/">Photography</ArrowLink>
  </CtaBand>
</Base>

<style>
  .about__inner {
    display: grid;
    gap: var(--space-xl);
  }

  .about__portrait {
    width: min(100%, 26rem);
    aspect-ratio: 4 / 5;
    overflow: clip;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  .about__portrait :global(picture) {
    height: 100%;
  }

  .about__text {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .about__title {
    font-size: var(--text-h1);
  }

  .about__statement {
    max-width: 26ch;
    color: var(--color-heading);
  }

  .about__body {
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--color-text-secondary);
  }

  .about__closing {
    font-size: var(--step-2);
  }

  @media (min-width: 64em) {
    .about__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
      align-items: start;
    }

    .about__portrait {
      position: sticky;
      top: calc(var(--header-h-condensed) + var(--space-l));
      width: 100%;
    }
  }
</style>
