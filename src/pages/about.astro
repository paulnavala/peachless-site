---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Media from '../components/ui/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import LitStatement from '../components/ui/LitStatement.astro';
import { getPublishedProjects, getSingleton } from '../lib/content';
import { TOOLS, TOOL_LABELS } from '../lib/content-schema';
import { toolCounts } from '../lib/project-order';
import { personLd } from '../lib/structured-data';

const about = await getSingleton('about');
const { Content } = await render(about);
const { eyebrow, title, statement, portrait, portraitAlt, closing, process: steps, experience, seo } = about.data;
const site = (await getSingleton('site')).data;
const portraitShare = await getImage({ src: portrait, width: 800, format: 'jpg' });
const tools = toolCounts(await getPublishedProjects(), TOOLS);
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="About" description={seo.description ?? statement} jsonLd={[personLd(site, Astro.site!, portraitShare.src)]}>
  <section class="section about">
    <div class="container about__inner">
      <div class="about__portrait about-portrait">
        <Media image={portrait} alt={portraitAlt} sizes="(min-width: 64em) 30rem, 90vw" priority />
      </div>
      <div class="about__text">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="about__title">{title}</h1>
        <p class="about__statement t-quote">{statement}</p>
        <div class="about__body flow">
          <Content />
        </div>
        {site.resume && <a class="btn btn--secondary about__resume" href={site.resume} download>Download my résumé</a>}
        {
          steps.length > 0 && (
            <section class="about-section" aria-labelledby="about-process">
              <h2 id="about-process" class="t-h2">How I work</h2>
              <ol class="about-steps" role="list">
                {steps.map((step, i) => (
                  <li>
                    <span class="about-steps__num" aria-hidden="true">{pad(i + 1)}</span>
                    <div>
                      <h3>{step.title}</h3>
                      <p>{step.body}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
        {
          tools.length > 0 && (
            <section class="about-section" aria-labelledby="about-tools">
              <h2 id="about-tools" class="t-h2">Tools</h2>
              <p class="about-section__note">Each one opens the work I made with it.</p>
              <ul class="cluster about-tools" role="list">
                {tools.map(({ tool, count }) => (
                  <li>
                    <a class="chip" href={`/projects/tools/${tool}/`}>
                      {TOOL_LABELS[tool]}
                      <span class="chip__count">{count}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          experience.length > 0 && (
            <section class="about-section" aria-labelledby="about-experience">
              <h2 id="about-experience" class="t-h2">Experience</h2>
              <ul class="about-experience" role="list">
                {experience.map((entry) => (
                  <li>
                    <span class="about-experience__period">{entry.period}</span>
                    <span class="about-experience__role">{entry.role}</span>
                    {entry.place && <span class="about-experience__place">{entry.place}</span>}
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {closing && <LitStatement tag="p" class="about__closing" text={closing} />}
      </div>
    </div>
  </section>

  <CtaBand heading="See the work behind the words." tone="paper">
    <ArrowLink href="/projects/">Explore my work</ArrowLink>
    <ArrowLink href="/photography/">Photography</ArrowLink>
  </CtaBand>
</Base>

<style>
  .about__inner {
    display: grid;
    gap: var(--space-xl);
  }

  /* An arch, like the home page's portrait (they morph into each other). */
  .about__portrait {
    width: min(100%, 26rem);
    aspect-ratio: 4 / 5;
    overflow: clip;
    border-radius: 50% 50% var(--radius-lg) var(--radius-lg) / 40% 40% var(--radius-lg) var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .about__portrait :global(picture) {
    height: 100%;
  }

  .about__text {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .about__title {
    font-size: var(--text-h1);
  }

  .about__statement {
    max-width: 26ch;
    color: var(--color-heading);
  }

  .about__body {
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--color-text-secondary);
  }

  .about__resume {
    justify-self: start;
  }

  .about-section {
    display: grid;
    gap: var(--space-s);
    margin-block-start: var(--space-m);
  }

  .about-section__note {
    color: var(--color-text-secondary);
  }

  .about-steps,
  .about-experience {
    display: grid;
    gap: var(--space-s);
    margin: 0;
  }

  .about-steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-s);
    align-items: baseline;
  }

  .about-steps__num {
    color: var(--color-accent-text);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .about-steps p {
    max-width: var(--measure);
    margin-block-start: var(--space-3xs);
    color: var(--color-text-secondary);
  }

  .about-tools {
    margin: 0;
    --cluster-gap: var(--space-2xs);
  }

  .about-experience li {
    display: grid;
    gap: 0 var(--space-m);
  }

  .about-experience__period {
    color: var(--color-text-muted);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .about-experience__role {
    font-weight: var(--weight-medium);
  }

  .about-experience__place {
    color: var(--color-text-secondary);
  }

  @media (min-width: 36em) {
    .about-experience li {
      grid-template-columns: 9rem minmax(0, 1fr);
    }

    .about-experience__period {
      grid-row: span 2;
    }

    .about-experience__place {
      grid-column: 2;
    }
  }

  /* The page ends on the tagline, lit word by word as it scrolls up: balanced,
     and wide enough to break between its two sentences. */
  .about__closing {
    max-width: 22ch;
    text-wrap: balance;
    margin-block-start: var(--space-l);
    font-family: var(--font-display);
    font-size: var(--text-display-2);
    font-style: italic;
    line-height: var(--leading-heading);
    color: var(--color-accent-text);
  }

  @media (min-width: 64em) {
    .about__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
      align-items: start;
    }

    /* Sticky, so it must fit under the header whole: on a short window the
       arch (4:5) narrows until its foot clears the bottom edge. */
    .about__portrait {
      position: sticky;
      top: calc(var(--header-h-condensed) + var(--space-l));
      width: min(100%, (100svh - var(--header-h-condensed) - 2 * var(--space-l)) * 0.8);
    }
  }
</style>
