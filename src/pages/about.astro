---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Media from '../components/ui/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import LitStatement from '../components/ui/LitStatement.astro';
import { getSingleton } from '../lib/content';
import { personLd } from '../lib/structured-data';

const about = await getSingleton('about');
const { Content } = await render(about);
const { eyebrow, title, statement, portrait, portraitAlt, closing, seo } = about.data;
const site = (await getSingleton('site')).data;
const portraitShare = await getImage({ src: portrait, width: 800, format: 'jpg' });
---
<Base title="About" description={seo.description ?? statement} jsonLd={[personLd(site, Astro.site!, portraitShare.src)]}>
  <section class="section about">
    <div class="container about__inner">
      <div class="about__portrait about-portrait">
        <Media image={portrait} alt={portraitAlt} sizes="(min-width: 64em) 30rem, 90vw" priority />
      </div>
      <div class="about__text">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="about__title">{title}</h1>
        <p class="about__statement t-quote">{statement}</p>
        <div class="about__body flow">
          <Content />
        </div>
        {closing && <LitStatement tag="p" class="about__closing" text={closing} />}
      </div>
    </div>
  </section>

  <CtaBand heading="See the work behind the words." tone="paper">
    <ArrowLink href="/projects/">Explore my work</ArrowLink>
    <ArrowLink href="/photography/">Photography</ArrowLink>
  </CtaBand>
</Base>

<style>
  .about__inner {
    display: grid;
    gap: var(--space-xl);
  }

  /* An arch, like the home page's portrait (they morph into each other). */
  .about__portrait {
    width: min(100%, 26rem);
    aspect-ratio: 4 / 5;
    overflow: clip;
    border-radius: 50% 50% var(--radius-lg) var(--radius-lg) / 40% 40% var(--radius-lg) var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .about__portrait :global(picture) {
    height: 100%;
  }

  .about__text {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .about__title {
    font-size: var(--text-h1);
  }

  .about__statement {
    max-width: 26ch;
    color: var(--color-heading);
  }

  .about__body {
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--color-text-secondary);
  }

  /* The page ends on the tagline, lit word by word as it scrolls up. */
  .about__closing {
    max-width: 18ch;
    margin-block-start: var(--space-l);
    font-family: var(--font-display);
    font-size: var(--text-display-2);
    font-style: italic;
    line-height: var(--leading-heading);
    color: var(--color-accent-text);
  }

  @media (min-width: 64em) {
    .about__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-2xl);
      align-items: start;
    }

    .about__portrait {
      position: sticky;
      top: calc(var(--header-h-condensed) + var(--space-l));
      width: 100%;
    }
  }
</style>
